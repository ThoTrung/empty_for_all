<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_rental_rented_qty_wizard_form" model="ir.ui.view">
            <field name="name">rental.rented.qty.wizard.form</field>
            <field name="model">rental.rented.qty.wizard</field>
            <field name="arch" type="xml">
                <form string="SL đang thuê theo ngày">
                    <group>
                        <group>
                            <field name="company_id" invisible="1"/>
                            <field name="as_of_date"/>
                            <field name="partner_company_id"
                                   options="{'no_create': True, 'no_create_edit': True}"/>
                        </group>
                        <group>
                            <field name="rental_contract_id"
                                   options="{'no_create': True, 'no_create_edit': True}"/>
                            <field name="product_tmpl_id"
                                   options="{'no_create': True, 'no_create_edit': True}"/>
                            <field name="only_active_contracts"
                                   invisible="rental_contract_id"/>
                        </group>
                    </group>
                    <field name="line_ids" nolabel="1">
                        <tree create="false" delete="false" edit="false">
                            <field name="partner_company_id"/>
                            <field name="rental_contract_id"/>
                            <field name="product_tmpl_id"/>
                            <field name="uom_name"/>
                            <field name="rented_qty" sum="Tổng đang thuê"/>
                            <field name="excess_qty" sum="Tổng chuyển thừa"/>
                            <field name="physical_qty" sum="Tổng vật lý"/>
                        </tree>
                    </field>
                    <footer>
                        <button name="action_compute"
                                type="object"
                                string="Tra cứu"
                                class="btn-primary"/>
                        <button string="Đóng" special="cancel" class="btn-secondary"/>
                    </footer>
                </form>
            </field>
        </record>

        <record id="action_rental_rented_qty_wizard" model="ir.actions.act_window">
            <field name="name">SL đang thuê theo ngày</field>
            <field name="res_model">rental.rented.qty.wizard</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
            <field name="context">{'default_only_active_contracts': True}</field>
        </record>
    </data>
</odoo>
