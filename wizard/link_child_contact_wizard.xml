<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_rental_link_child_contact_wizard_form" model="ir.ui.view">
        <field name="name">rental.link.child.contact.wizard.form</field>
        <field name="model">rental.link_child_contact.wizard</field>
        <field name="arch" type="xml">
            <form string="Gắn đại diện có sẵn">
                <group>
                    <field name="parent_partner_id"/>
                    <field name="company_scope_id" invisible="1"/>
                    <field name="allowed_partner_ids" invisible="1"/>
                    <field name="partner_id" options="{'no_create': True, 'no_create_edit': True}"/>
                </group>
                <footer>
                    <button name="action_link" type="object" string="Gắn" class="btn-primary"/>
                    <button string="Hủy" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
