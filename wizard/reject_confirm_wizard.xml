<odoo>
    <record id="view_rental_reject_confirm_wizard_form" model="ir.ui.view">
        <field name="name">rental.reject.confirm.wizard.form</field>
        <field name="model">rental.reject.confirm.wizard</field>
        <field name="arch" type="xml">
            <form string="Không xác nhận">
                <sheet>
                    <group>
                        <field name="message_reason" placeholder="Nhập lý do không xác nhận..." />
                    </group>
                </sheet>
                <footer>
                    <button name="action_reject" type="object" string="Đồng ý" class="btn-primary"/>
                    <button string="Hủy" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="action_rental_reject_confirm_wizard" model="ir.actions.act_window">
        <field name="name">Không xác nhận</field>
        <field name="res_model">rental.reject.confirm.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>

