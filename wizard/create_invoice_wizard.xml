<odoo>
    <data>
        <record id="view_create_invoice_wizard_form" model="ir.ui.view">
            <field name="name">create.invoice.wizard.form</field>
            <field name="model">create.invoice.wizard</field>
            <field name="arch" type="xml">
                <form>
                    <group>
                        <group>
                            <field name="start_date" placehodle=""/>
                            <field name="end_date" placehodle=""/>
                        </group>
                    </group>
                    <footer>
                        <button
                                name="choose_invoice_date_range"
                                string="Confirm date"
                                type="object"
                                class="btn-primary"
                        />
                        <button special="cancel" data-hotkey="x" string="Discard" class="btn-secondary"/>
                    </footer>
                </form>
            </field>
        </record>

        <record id="action_create_invoice_wizard" model="ir.actions.act_window">
            <field name="name">Form date to date</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">create.invoice.wizard</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
        </record>
    </data>
</odoo>
