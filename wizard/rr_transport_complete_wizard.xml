<odoo>
    <record id="view_rr_transport_complete_wizard_form" model="ir.ui.view">
        <field name="name">rr.transport.complete.wizard.form</field>
        <field name="model">rr.transport.complete.wizard</field>
        <field name="arch" type="xml">
            <form string="Không đủ hàng">
                <field name="transport_id" invisible="1"/>
                <field name="message" nolabel="1"/>
                <footer>
                    <button name="action_confirm" type="object" string="Đồng ý xuất âm" class="btn-warning"/>
                    <button string="Hủy" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
