<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_subrent_direct_delivery_wizard_form" model="ir.ui.view">
        <field name="name">subrent.direct.delivery.wizard.form</field>
        <field name="model">rental.subrent.direct.delivery.wizard</field>
        <field name="arch" type="xml">
            <form string="Lô giao thẳng">
                <group>
                    <field name="company_id" groups="base.group_multi_company"/>
                    <field name="subrent_contract_id"/>
                    <field name="product_id"/>
                    <field name="qty"/>
                    <field name="date"/>
                </group>
                <footer>
                    <button name="action_create_lot" type="object" string="Tạo lô giao thẳng" class="btn-primary"/>
                    <button string="Hủy" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="action_subrent_direct_delivery_wizard" model="ir.actions.act_window">
        <field name="name">Tạo lô giao thẳng</field>
        <field name="res_model">rental.subrent.direct.delivery.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
