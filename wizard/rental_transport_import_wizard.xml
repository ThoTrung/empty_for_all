<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_rental_transport_import_wizard_form" model="ir.ui.view">
        <field name="name">rental.transport.import.wizard.form</field>
        <field name="model">rental.transport.import.wizard</field>
        <field name="arch" type="xml">
            <form string="Import xuất nhập kho từ Excel">
                <field name="state" invisible="1"/>
                <group invisible="state != 'upload'">
                    <group>
                        <field name="rental_contract_id"/>
                        <field name="default_driver_id"
                               options="{'no_quick_create': True}"
                               context="{'rental_contact_quick': 1, 'default_customer_type': 'driver', 'default_is_company': False}"/>
                        <field name="auto_create_truck"/>
                        <field name="validate_picking"/>
                    </group>
                    <group>
                        <button name="action_download_template"
                                type="object"
                                string="Tải biểu mẫu Excel"
                                class="btn-link"
                                icon="fa-download"/>
                        <field name="import_file" filename="import_filename"/>
                        <field name="import_filename" invisible="1"/>
                    </group>
                </group>
                <group invisible="state == 'upload'">
                    <field name="summary" nolabel="1" colspan="2"/>
                </group>
                <notebook invisible="state == 'upload'">
                    <page string="Xem trước">
                        <field name="preview_line_ids" nolabel="1">
                            <tree create="0" delete="0" edit="0"
                                  decoration-danger="status == 'error'"
                                  decoration-success="status == 'ok'">
                                <field name="row_number"/>
                                <field name="transport_date"/>
                                <field name="plate"/>
                                <field name="transport_type"/>
                                <field name="line_count"/>
                                <field name="status" widget="badge"
                                       decoration-success="status == 'ok'"
                                       decoration-danger="status == 'error'"/>
                                <field name="message"/>
                            </tree>
                        </field>
                    </page>
                    <page string="Lỗi mapping sản phẩm"
                          invisible="not product_mapping_summary">
                        <field name="product_mapping_summary" nolabel="1" widget="text"/>
                    </page>
                </notebook>
                <footer>
                    <button name="action_download_template"
                            string="Tải biểu mẫu"
                            type="object"
                            class="btn-secondary"
                            icon="fa-download"
                            invisible="state != 'upload'"/>
                    <button name="action_parse_file"
                            string="Đọc file"
                            type="object"
                            class="btn-primary"
                            invisible="state != 'upload'"/>
                    <button name="action_import_transports"
                            string="Nhập"
                            type="object"
                            class="btn-primary"
                            invisible="state != 'preview'"
                            confirm="Tạo phiếu xuất nhập kho từ các dòng không lỗi?"/>
                    <button special="cancel" string="Đóng" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_rental_transport_import_wizard" model="ir.actions.act_window">
        <field name="name">Import xuất nhập kho từ Excel</field>
        <field name="res_model">rental.transport.import.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
