<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_rental_transport_matrix_overlap_wizard_form" model="ir.ui.view">
            <field name="name">rental.transport.matrix.overlap.wizard.form</field>
            <field name="model">rental.transport.matrix.overlap.wizard</field>
            <field name="arch" type="xml">
                <form string="Trùng khoảng thời gian" create="false" edit="false">
                    <field name="rental_contract_id" invisible="1"/>
                    <div class="o_rental_matrix_overlap_body px-1">
                        <div class="alert alert-warning mb-3" role="alert">
                            <p class="mb-0 text-wrap">
                                Khoảng thời gian đã chọn (ngày bắt đầu – ngày kết thúc) trùng với ít nhất một bảng xác nhận khối lượng đã có trên hợp đồng này.
                                Vui lòng chọn khoảng ngày khác hoặc mở danh sách các bảng đã tạo.
                            </p>
                        </div>
                    </div>
                    <footer>
                        <button name="action_open_transport_matrices"
                                type="object"
                                string="Bảng xác nhận khối lượng"
                                class="btn-primary"/>
                        <button string="Đóng" special="cancel" class="btn-secondary"/>
                    </footer>
                </form>
            </field>
        </record>
    </data>
</odoo>
