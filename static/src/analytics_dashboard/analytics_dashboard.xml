<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="rental.AnalyticsBarChart">
        <div class="o_rental_analytics_chart">
            <canvas t-ref="canvas"/>
        </div>
    </t>

    <t t-name="rental.AnalyticsDashboard">
        <Layout display="display" className="'o_rental_analytics_dashboard'">
            <div class="o_rental_analytics_dashboard_body p-3">
                <div class="d-flex flex-wrap align-items-end gap-3 mb-3">
                    <div>
                        <label class="form-label mb-1" for="rental_analytics_as_of">
                            Ngày as-of
                        </label>
                        <input
                            id="rental_analytics_as_of"
                            type="date"
                            class="form-control"
                            t-att-value="state.asOfDate"
                            t-on-change="onAsOfDateChange"
                        />
                    </div>
                    <div>
                        <label class="form-label mb-1" for="rental_analytics_partner">
                            Khách hàng
                        </label>
                        <select
                            id="rental_analytics_partner"
                            class="form-select"
                            t-att-value="state.partnerCompanyId"
                            t-on-change="onPartnerChange"
                        >
                            <option value="">Tất cả</option>
                            <t t-foreach="state.partners" t-as="partner" t-key="partner.id">
                                <option t-att-value="partner.id" t-esc="partner.name"/>
                            </t>
                        </select>
                    </div>
                    <div>
                        <label class="form-label mb-1" for="rental_analytics_work">
                            Công trình
                        </label>
                        <select
                            id="rental_analytics_work"
                            class="form-select"
                            t-att-value="state.constructionWorkId"
                            t-on-change="onConstructionWorkChange"
                        >
                            <option value="">Tất cả</option>
                            <t t-foreach="state.constructionWorks" t-as="work" t-key="work.id">
                                <option t-att-value="work.id" t-esc="work.name"/>
                            </t>
                        </select>
                    </div>
                    <button
                        type="button"
                        class="btn btn-primary"
                        t-on-click="onRefresh"
                        t-att-disabled="state.loading"
                    >
                        Làm mới
                    </button>
                    <button
                        type="button"
                        class="btn btn-secondary"
                        t-on-click="onOpenRentedQtyWizard"
                    >
                        Tra cứu theo ngày
                    </button>
                    <div t-if="state.asOfDateDisplay" class="text-muted align-self-center">
                        Đang xem: <t t-esc="state.asOfDateDisplay"/>
                    </div>
                </div>

                <div t-if="state.loading" class="text-muted">Đang tải thống kê…</div>
                <div t-elif="state.error" class="alert alert-danger" t-esc="state.error"/>
                <div t-else="" class="row g-3">
                    <t t-foreach="state.widgets" t-as="widget" t-key="widget.key">
                        <div class="col-12 col-xl-6">
                            <div
                                class="card o_rental_analytics_card h-100"
                                role="button"
                                t-on-click="() => this.onOpenWidget(widget)"
                            >
                                <div class="card-body">
                                    <div class="d-flex justify-content-between align-items-start mb-2">
                                        <div>
                                            <h3 class="h5 mb-1" t-esc="widget.title"/>
                                            <div class="text-muted small" t-esc="widget.subtitle"/>
                                            <div t-if="widget.computed_at" class="text-muted small">
                                                Snapshot: <t t-esc="widget.computed_at"/>
                                            </div>
                                        </div>
                                        <div class="text-end">
                                            <t t-if="widget.total_label">
                                                <div class="text-muted small" t-esc="widget.total_label"/>
                                                <div class="fs-4 fw-bold">
                                                    <t t-esc="widget.total_value_display or this.formatNumber(widget.total_value)"/>
                                                </div>
                                            </t>
                                        </div>
                                    </div>

                                    <t t-if="widget.totals_by_uom and widget.totals_by_uom.length">
                                        <div class="o_rental_analytics_uom_totals mb-2">
                                            <t t-foreach="widget.totals_by_uom" t-as="uomRow" t-key="uomRow.uom_id or uomRow.uom_name">
                                                <div class="d-flex flex-wrap justify-content-between gap-2 small border-bottom py-1">
                                                    <strong t-esc="uomRow.uom_name"/>
                                                    <span>
                                                        <span class="text-muted" t-esc="widget.metrics.rented_label"/>:
                                                        <t t-esc="this.formatNumber(uomRow.rented_qty)"/>
                                                        <span class="mx-1">|</span>
                                                        <span class="text-muted" t-esc="widget.metrics.excess_label"/>:
                                                        <t t-esc="this.formatNumber(uomRow.excess_qty)"/>
                                                        <span class="mx-1">|</span>
                                                        Vật lý:
                                                        <t t-esc="this.formatNumber(uomRow.physical_qty)"/>
                                                    </span>
                                                </div>
                                            </t>
                                        </div>
                                    </t>

                                    <t t-if="widget.chart and widget.chart.labels and widget.chart.labels.length">
                                        <RentalAnalyticsBarChart
                                            labels="widget.chart.labels"
                                            values="widget.chart.values"
                                            datasetLabel="widget.chart.dataset_label"
                                        />
                                    </t>
                                    <div t-else="" class="text-muted py-5 text-center">
                                        <t t-esc="widget.empty_message or 'Không có dữ liệu.'"/>
                                    </div>
                                    <div class="text-primary small mt-2">
                                        Click để xem chi tiết
                                    </div>
                                </div>
                            </div>
                        </div>
                    </t>
                    <div t-if="!state.widgets.length" class="col-12 text-muted">
                        Chưa có widget thống kê nào được đăng ký.
                    </div>
                </div>
            </div>
        </Layout>
    </t>
</templates>
