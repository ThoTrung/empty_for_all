<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_gara_warranty_lookup_wizard_form" model="ir.ui.view">
        <field name="name">gara.warranty.lookup.wizard.form</field>
        <field name="model">gara.warranty.lookup.wizard</field>
        <field name="arch" type="xml">
            <form string="Tra cứu bảo hành">
                <group>
                    <field name="query" placeholder="Biển số, serial, mã claim hoặc tên khách hàng"/>
                    <field name="state"/>
                </group>
                <footer>
                    <button name="action_lookup" string="Tra cứu" type="object" class="btn-primary"/>
                    <button string="Hủy" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_gara_warranty_lookup_wizard" model="ir.actions.act_window">
        <field name="name">Tra cứu bảo hành</field>
        <field name="res_model">gara.warranty.lookup.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
