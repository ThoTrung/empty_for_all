<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_spa_staff_payroll_generate_wizard" model="ir.ui.view">
        <field name="name">spa.staff.payroll.generate.wizard.form</field>
        <field name="model">spa.staff.payroll.generate.wizard</field>
        <field name="arch" type="xml">
            <form string="Tạo phiếu lương theo tháng">
                <div class="alert alert-info mb-3" role="alert">
                    <p class="mb-1"><strong>Trước khi tạo:</strong></p>
                    <ul class="mb-0 ps-3">
                        <li>Tạo <b>Nhân viên</b> và gắn <b>User</b> đăng nhập (menu <b>Spa → Lương NV → Nhân viên (HR)</b>).</li>
                        <li>Tạo <b>Hợp đồng lao động</b> trạng thái <b>Đang chạy</b>, nhập lương và đơn giá làm thêm/giờ (menu <b>Hợp đồng lao động</b>).</li>
                    </ul>
                </div>
                <group>
                    <field name="company_id"/>
                    <field name="year"/>
                    <field name="month"/>
                    <field name="employee_ids" widget="many2many_tags" options="{'no_create': True}"/>
                </group>
                <footer>
                    <button name="action_generate" string="Tạo" type="object" class="btn-primary" data-hotkey="q"/>
                    <button string="Đóng" class="btn-secondary" special="cancel" data-hotkey="z"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="action_spa_staff_payroll_generate_wizard" model="ir.actions.act_window">
        <field name="name">Tạo phiếu lương theo tháng</field>
        <field name="res_model">spa.staff.payroll.generate.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
