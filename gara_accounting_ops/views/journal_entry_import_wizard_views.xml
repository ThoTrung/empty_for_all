<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_gara_journal_entry_import_wizard_form" model="ir.ui.view">
        <field name="name">gara.journal.entry.import.wizard.form</field>
        <field name="model">gara.journal.entry.import.wizard</field>
        <field name="arch" type="xml">
            <form string="Nhập chứng từ Excel">
                <group>
                    <group>
                        <field name="company_id"/>
                        <field name="journal_id"/>
                        <field name="gara_document_group_id"/>
                        <field name="gara_document_reason_id"/>
                    </group>
                    <group>
                        <field name="file_name" invisible="1"/>
                        <field name="file_data" filename="file_name"/>
                        <field name="xlsx_sheet_label"/>
                        <field name="xlsx_sheet_name"/>
                    </group>
                </group>
                <separator string="Cấu trúc file"/>
                <p class="text-muted">
                    Header bắt buộc: entry_ref, account, debit, credit.
                    Header tùy chọn: date, label, partner. Mỗi entry_ref phải cân Nợ/Có.
                </p>
                <footer>
                    <button name="action_import" string="Import" type="object" class="btn-primary"/>
                    <button string="Hủy" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_gara_journal_entry_import_wizard" model="ir.actions.act_window">
        <field name="name">Nhập chứng từ Excel</field>
        <field name="res_model">gara.journal.entry.import.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
