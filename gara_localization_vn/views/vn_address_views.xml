<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_gara_vn_province_tree" model="ir.ui.view">
        <field name="name">gara.vn.province.tree</field>
        <field name="model">gara.vn.province</field>
        <field name="arch" type="xml">
            <tree>
                <field name="sequence" widget="handle"/>
                <field name="code"/>
                <field name="name"/>
                <field name="country_id"/>
                <field name="state_id"/>
                <field name="active"/>
            </tree>
        </field>
    </record>
    <record id="view_gara_vn_province_form" model="ir.ui.view">
        <field name="name">gara.vn.province.form</field>
        <field name="model">gara.vn.province</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="code"/>
                        <field name="name"/>
                        <field name="country_id"/>
                        <field name="state_id"/>
                        <field name="sequence"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_gara_vn_province" model="ir.actions.act_window">
        <field name="name">Tỉnh / Thành phố</field>
        <field name="res_model">gara.vn.province</field>
        <field name="view_mode">tree,form</field>
    </record>

    <record id="view_gara_vn_district_tree" model="ir.ui.view">
        <field name="name">gara.vn.district.tree</field>
        <field name="model">gara.vn.district</field>
        <field name="arch" type="xml">
            <tree>
                <field name="sequence" widget="handle"/>
                <field name="province_id"/>
                <field name="code"/>
                <field name="name"/>
                <field name="active"/>
            </tree>
        </field>
    </record>
    <record id="view_gara_vn_district_form" model="ir.ui.view">
        <field name="name">gara.vn.district.form</field>
        <field name="model">gara.vn.district</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="province_id"/>
                        <field name="code"/>
                        <field name="name"/>
                        <field name="sequence"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_gara_vn_district" model="ir.actions.act_window">
        <field name="name">Quận / Huyện</field>
        <field name="res_model">gara.vn.district</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{'search_default_group_province': 1}</field>
    </record>

    <record id="view_gara_vn_district_search" model="ir.ui.view">
        <field name="name">gara.vn.district.search</field>
        <field name="model">gara.vn.district</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="code"/>
                <field name="province_id"/>
                <group expand="0" string="Group By">
                    <filter name="group_province" string="Province" context="{'group_by': 'province_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_gara_vn_ward_tree" model="ir.ui.view">
        <field name="name">gara.vn.ward.tree</field>
        <field name="model">gara.vn.ward</field>
        <field name="arch" type="xml">
            <tree>
                <field name="sequence" widget="handle"/>
                <field name="province_id"/>
                <field name="district_id"/>
                <field name="code"/>
                <field name="name"/>
                <field name="postal_code"/>
                <field name="active"/>
            </tree>
        </field>
    </record>
    <record id="view_gara_vn_ward_form" model="ir.ui.view">
        <field name="name">gara.vn.ward.form</field>
        <field name="model">gara.vn.ward</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="district_id"/>
                        <field name="province_id"/>
                        <field name="code"/>
                        <field name="name"/>
                        <field name="postal_code"/>
                        <field name="sequence"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="view_gara_vn_ward_search" model="ir.ui.view">
        <field name="name">gara.vn.ward.search</field>
        <field name="model">gara.vn.ward</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="code"/>
                <field name="district_id"/>
                <field name="province_id"/>
                <group expand="0" string="Group By">
                    <filter name="group_province" string="Province" context="{'group_by': 'province_id'}"/>
                    <filter name="group_district" string="District" context="{'group_by': 'district_id'}"/>
                </group>
            </search>
        </field>
    </record>
    <record id="action_gara_vn_ward" model="ir.actions.act_window">
        <field name="name">Phường / Xã</field>
        <field name="res_model">gara.vn.ward</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_gara_vn_ward_search"/>
        <field name="context">{'search_default_group_district': 1}</field>
    </record>
</odoo>
