# URL gốc Odoo (HTTPS), không có dấu / cuối
VITE_API_BASE_URL=https://your-odoo-domain.com

# Tuỳ chọn: URL trang tin trên website (mở bằng nút trên màn Tin tức)
# VITE_WEBSITE_NEWS_URL=https://your-odoo-domain.com/aitilen/news

