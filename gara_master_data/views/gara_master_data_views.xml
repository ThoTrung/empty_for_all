        <field name="model">gara.service.package</field>
        <field name="arch" type="xml">
            <tree>
                <field name="sequence" widget="handle"/>
                <field name="code"/>
                <field name="name"/>
                <field name="service_product_id"/>
                <field name="amount_untaxed"/>
                <field name="company_id"/>
                <field name="active"/>
            </tree>
        </field>
    </record>
    <record id="view_gara_service_package_form" model="ir.ui.view">
        <field name="name">gara.service.package.form</field>
        <field name="model">gara.service.package</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="code"/>
                        <field name="name"/>
                        <field name="service_product_id"/>
                        <field name="company_id"/>
                    </group>
                    <group>
                        <field name="sequence"/>
                        <field name="active"/>
                        <field name="amount_untaxed"/>
                    </group>
                    <notebook>
                        <page string="Package Lines">
                            <field name="line_ids">
                                <tree editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="product_id"/>
                                    <field name="name"/>
                                    <field name="product_uom_id"/>
                                    <field name="quantity"/>
                                    <field name="price_unit"/>
                                    <field name="discount"/>
                                    <field name="subtotal"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Notes">
                            <field name="note" placeholder="Notes..." nolabel="1"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_gara_service_package" model="ir.actions.act_window">
