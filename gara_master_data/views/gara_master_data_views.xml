    <record id="view_gara_revenue_type_tree" model="ir.ui.view">
        <field name="name">gara.revenue.type.tree</field>
        <field name="model">gara.revenue.type</field>
        <field name="arch" type="xml">
            <tree>
                <field name="sequence" widget="handle"/>
                <field name="code"/>
                <field name="name"/>
                <field name="company_id"/>
                <field name="income_account_id"/>
                <field name="product_category_id"/>
                <field name="active"/>
            </tree>
        </field>
    </record>
    <record id="view_gara_revenue_type_form" model="ir.ui.view">
        <field name="name">gara.revenue.type.form</field>
        <field name="model">gara.revenue.type</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="code"/>
                        <field name="name"/>
                        <field name="sequence"/>
                        <field name="active"/>
                    </group>
                    <group>
                        <field name="company_id"/>
                        <field name="income_account_id"/>
                        <field name="product_category_id"/>
                    </group>
                    <field name="note" placeholder="Notes..." nolabel="1"/>
                </sheet>
            </form>
        </field>
    </record>
