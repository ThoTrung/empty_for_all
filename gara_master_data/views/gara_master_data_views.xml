    <record id="view_product_template_form_gara_master_data" model="ir.ui.view">
        <field name="name">product.template.form.gara.master.data</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='categ_id']" position="after">
                <field name="gara_product_type_id"/>
            </xpath>
        </field>
    </record>
</odoo>
