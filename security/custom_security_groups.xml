<?xml version="1.0"?>
<odoo>
    <data>
        <!-- Security Category (Groups Section) -->
        <record id="module_category_rental" model="ir.module.category">
            <field name="name">Rental</field>
            <field name="sequence">10</field>
        </record>

        <record id="group_rental_staff" model="res.groups">
            <field name="name">01. Rental Staff</field>
            <field name="category_id" ref="rental.module_category_rental"/>
        </record>

        <record id="group_rental_transport_courier" model="res.groups">
            <field name="name">05. Rental — Người giao / nhận hàng</field>
            <field name="category_id" ref="rental.module_category_rental"/>
            <field name="implied_ids" eval="[(4, ref('stock.group_stock_user'))]"/>
            <field name="comment">Menu Rental: chỉ mục Tồn kho (Sản phẩm / Biến thể chỉ xem; Xuất nhập kho + xác nhận phiếu kho theo phiếu được gán). Quyền kho chuẩn Odoo (stock user) để Validate; phiếu kho giới hạn bởi rule. Không gắn đồng thời Staff nếu cần tách quyền.</field>
        </record>

        <record id="group_rental_leader" model="res.groups">
            <field name="name">02. Rental Leader</field>
            <field name="implied_ids" eval="[(4, ref('group_rental_staff'))]"/>
            <field name="category_id" ref="rental.module_category_rental"/>
        </record>

        <record id="group_rental_manager" model="res.groups">
            <field name="name">03. Rental Manager</field>
            <field name="implied_ids" eval="[(4, ref('group_rental_leader'))]"/>
            <field name="category_id" ref="rental.module_category_rental"/>
        </record>

        <record id="group_rental_admin" model="res.groups">
            <field name="name">04. Rental Administrator</field>
            <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
            <field name="implied_ids" eval="[(4, ref('group_rental_manager'))]"/>
            <field name="category_id" ref="rental.module_category_rental"/>
        </record>
    </data>
</odoo>
