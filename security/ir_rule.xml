    <data>
        <!-- Multi-company rule: only see records in your allowed companies -->
<!--        Not share between branches -->
        <record id="rental_contract_company_rule" model="ir.rule">
            <field name="name">Rental Contract: multi-company</field>
            <field name="model_id" ref="model_rental_contract"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
            <!-- If you want, set the explicit perms (defaults are True) -->
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>
