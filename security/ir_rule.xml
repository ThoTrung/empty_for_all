            <field name="model_id" ref="model_rr_transport"/>
            <field name="domain_force">['&amp;', ('company_id', 'in', company_ids), '|', ('deliverer_partner_id', '=', user.partner_id.id), ('receiver_partner_id', '=', user.partner_id.id)]</field>
