<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="group_rental_subrent_user" model="res.groups">
            <field name="name">Thuê ngoài — Nhân viên</field>
            <field name="category_id" ref="rental.module_category_rental"/>
            <field name="implied_ids" eval="[(4, ref('rental.group_rental_staff'))]"/>
        </record>
        <record id="group_rental_subrent_manager" model="res.groups">
            <field name="name">Thuê ngoài — Quản lý</field>
            <field name="category_id" ref="rental.module_category_rental"/>
            <field name="implied_ids" eval="[(4, ref('group_rental_subrent_user')), (4, ref('rental.group_rental_manager'))]"/>
            <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        </record>
    </data>
</odoo>
