<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <!-- Enforce readonly booking scope even when user carries other booking-related groups. -->
        <record id="rule_spa_service_booking_staff_readonly_scope_gate" model="ir.rule">
            <field name="name">Booking readonly gate: only my assigned bookings</field>
            <field name="model_id" ref="booking_calendar.model_spa_service_booking"/>
            <field name="domain_force">[(1, '=', 1)] if not user.has_group('spa.group_spa_staff_readonly') else ['|', '|', ('staff_id', '=', user.id), ('staff_ids', 'in', [user.id]), ('booking_line_ids.staff_id', '=', user.id)]</field>
        </record>

        <record id="rule_spa_service_booking_line_staff_readonly_scope_gate" model="ir.rule">
            <field name="name">Booking line readonly gate: lines of my assigned bookings</field>
            <field name="model_id" ref="booking_calendar.model_spa_service_booking_line"/>
            <field name="domain_force">[(1, '=', 1)] if not user.has_group('spa.group_spa_staff_readonly') else ['|', '|', ('booking_id.staff_id', '=', user.id), ('booking_id.staff_ids', 'in', [user.id]), ('booking_id.booking_line_ids.staff_id', '=', user.id)]</field>
        </record>
    </data>
</odoo>
