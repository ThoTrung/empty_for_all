<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="seq_gara_workshop_case" model="ir.sequence">
            <field name="name">Gara workshop case</field>
            <field name="code">gara.workshop.case</field>
            <field name="prefix">GWC/%(y)s/</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>
        <record id="seq_gara_warranty_claim" model="ir.sequence">
            <field name="name">Gara warranty claim</field>
            <field name="code">gara.warranty.claim</field>
            <field name="prefix">WCL/%(y)s/</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>
        <record id="seq_gara_insurance_claim" model="ir.sequence">
            <field name="name">Gara insurance claim</field>
            <field name="code">gara.insurance.claim</field>
            <field name="prefix">ICL/%(y)s/</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>
        <record id="seq_gara_approval_request" model="ir.sequence">
            <field name="name">Gara approval request</field>
            <field name="code">gara.approval.request</field>
            <field name="prefix">APR/%(y)s/</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>
    </data>
</odoo>
