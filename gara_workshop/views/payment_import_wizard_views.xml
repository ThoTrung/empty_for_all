<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_gara_payment_import_wizard_form" model="ir.ui.view">
        <field name="name">gara.payment.import.wizard.form</field>
        <field name="model">gara.payment.import.wizard</field>
        <field name="arch" type="xml">
            <form string="Import payments from CSV/XLSX">
                <sheet>
                    <group>
                        <field name="company_id"/>
                        <field name="create_account_payment"/>
                        <field name="payment_journal_id" invisible="not create_account_payment"/>
                    </group>
                    <group>
                        <field name="file_name" invisible="1"/>
                        <field name="file_data" filename="file_name"/>
                        <field name="xlsx_sheet_label"/>
                        <field name="xlsx_sheet_name"/>
                    </group>
                    <div class="o_form_label">Headers: case_ref,amount,payment_date,note (supported: .csv, .xlsx). Optional: register posted customer payments in Accounting.</div>
                </sheet>
                <footer>
                    <button name="action_import" type="object" string="Import" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="action_gara_payment_import_wizard" model="ir.actions.act_window">
        <field name="name">Import payments</field>
        <field name="res_model">gara.payment.import.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
