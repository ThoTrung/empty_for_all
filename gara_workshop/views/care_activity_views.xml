<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_gara_care_activity_tree" model="ir.ui.view">
        <field name="name">gara.care.activity.tree</field>
        <field name="model">gara.care.activity</field>
        <field name="arch" type="xml">
            <tree>
                <field name="activity_date"/>
                <field name="partner_id"/>
                <field name="case_id"/>
                <field name="name"/>
                <field name="channel"/>
                <field name="outcome"/>
            </tree>
        </field>
    </record>
    <record id="view_gara_care_activity_form" model="ir.ui.view">
        <field name="name">gara.care.activity.form</field>
        <field name="model">gara.care.activity</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="partner_id"/>
                        <field name="case_id"/>
                        <field name="channel"/>
                        <field name="activity_date"/>
                        <field name="outcome"/>
                    </group>
                    <field name="body" nolabel="1"/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="action_gara_care_activity" model="ir.actions.act_window">
        <field name="name">Care activities</field>
        <field name="res_model">gara.care.activity</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
