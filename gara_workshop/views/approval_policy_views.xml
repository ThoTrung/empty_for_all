<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_gara_approval_policy_tree" model="ir.ui.view">
        <field name="name">gara.approval.policy.tree</field>
        <field name="model">gara.approval.policy</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="request_type"/>
                <field name="min_amount"/>
                <field name="max_amount"/>
                <field name="active"/>
            </tree>
        </field>
    </record>
    <record id="view_gara_approval_policy_form" model="ir.ui.view">
        <field name="name">gara.approval.policy.form</field>
        <field name="model">gara.approval.policy</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="active"/>
                        <field name="company_id" groups="base.group_multi_company"/>
                        <field name="request_type"/>
                    </group>
                    <group>
                        <field name="min_amount"/>
                        <field name="max_amount"/>
                    </group>
                    <notebook>
                        <page string="Approval chain" name="chain">
                            <field name="line_ids" nolabel="1">
                                <tree editable="bottom">
                                    <field name="sequence"/>
                                    <field name="approver_group_id"/>
                                    <field name="approver_user_id"/>
                                </tree>
                            </field>
                            <p class="text-muted">If lines are set, they define the full chain in order. Otherwise legacy approver fields below are used (one or two steps).</p>
                        </page>
                        <page string="Legacy approvers" name="legacy">
                            <group>
                                <field name="approver_group_id"/>
                                <field name="approver_user_id"/>
                            </group>
                            <group>
                                <field name="second_approver_group_id"/>
                                <field name="second_approver_user_id"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_gara_approval_policy" model="ir.actions.act_window">
        <field name="name">Approval Policies</field>
        <field name="res_model">gara.approval.policy</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
