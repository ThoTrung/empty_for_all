<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_gara_warranty_claim_tree" model="ir.ui.view">
        <field name="name">gara.warranty.claim.tree</field>
        <field name="model">gara.warranty.claim</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="case_id"/>
                <field name="vehicle_id"/>
                <field name="state"/>
            </tree>
        </field>
    </record>
    <record id="view_gara_warranty_claim_form" model="ir.ui.view">
        <field name="name">gara.warranty.claim.form</field>
        <field name="model">gara.warranty.claim</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="company_id" groups="base.group_multi_company"/>
                        <field name="case_id"/>
                        <field name="vehicle_id"/>
                        <field name="product_id"/>
                    </group>
                    <field name="description" nolabel="1"/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="action_gara_warranty_claim" model="ir.actions.act_window">
        <field name="name">Warranty claims</field>
        <field name="res_model">gara.warranty.claim</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
