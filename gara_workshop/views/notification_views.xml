<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_gara_notification_tree" model="ir.ui.view">
        <field name="name">gara.notification.tree</field>
        <field name="model">gara.notification</field>
        <field name="arch" type="xml">
            <tree decoration-muted="state == 'done'" decoration-danger="priority == '2' and state == 'open'">
                <field name="date"/>
                <field name="priority"/>
                <field name="notification_type"/>
                <field name="name"/>
                <field name="user_id"/>
                <field name="partner_id"/>
                <field name="case_id"/>
                <field name="state"/>
            </tree>
        </field>
    </record>

    <record id="view_gara_notification_form" model="ir.ui.view">
        <field name="name">gara.notification.form</field>
        <field name="model">gara.notification</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_open_record" type="object" string="Open Record" invisible="not model or not res_id"/>
                    <button name="action_done" type="object" string="Done" class="btn-primary" invisible="state == 'done'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="notification_type"/>
                        <field name="priority"/>
                        <field name="date"/>
                        <field name="user_id"/>
                        <field name="partner_id"/>
                        <field name="case_id"/>
                        <field name="model"/>
                        <field name="res_id"/>
                    </group>
                    <field name="note" nolabel="1"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_gara_notification_generate" model="ir.actions.server">
        <field name="name">Generate Notifications</field>
        <field name="model_id" ref="model_gara_notification"/>
        <field name="state">code</field>
        <field name="code">model.action_generate_notifications()</field>
    </record>

    <record id="action_gara_notification" model="ir.actions.act_window">
        <field name="name">Sổ thông báo</field>
        <field name="res_model">gara.notification</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
