<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_gara_workshop" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.gara.workshop</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base_setup.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app string="Gara Workshop" name="gara_workshop" groups="gara_workshop.group_gara_workshop_manager">
                    <field name="company_country_code" invisible="1"/>
                    <block title="Approval Thresholds">
                        <setting string="Case close threshold">
                            <field name="gara_close_approval_threshold"/>
                        </setting>
                        <setting string="Insurance approval threshold">
                            <field name="gara_insurance_approval_threshold"/>
                        </setting>
                        <setting string="Require quotation approval before confirm">
                            <field name="gara_quote_require_approval"/>
                        </setting>
                    </block>
                    <block title="Membership Ledger">
                        <setting string="Member point rate (per currency unit)">
                            <field name="gara_member_point_rate"/>
                        </setting>
                    </block>
                    <block title="Vietnam accounting (TT200 / l10n_vn)" invisible="company_country_code != 'VN'">
                        <setting string="Gara default products" help="Maps workshop demo products to 5113 (service), 5111 + 632 (goods/COGS), and company sale VAT when empty. Run again after loading the Vietnam chart.">
                            <button name="action_gara_apply_vn_product_accounts" type="object" string="Apply TT200 mapping" class="btn-primary"/>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>
</odoo>
