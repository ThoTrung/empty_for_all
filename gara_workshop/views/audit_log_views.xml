<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_gara_audit_log_tree" model="ir.ui.view">
        <field name="name">gara.audit.log.tree</field>
        <field name="model">gara.audit.log</field>
        <field name="arch" type="xml">
            <tree>
                <field name="create_date"/>
                <field name="case_id"/>
                <field name="user_id"/>
                <field name="event_type"/>
                <field name="model_name"/>
                <field name="res_id"/>
                <field name="action"/>
                <field name="detail"/>
            </tree>
        </field>
    </record>
    <record id="action_gara_audit_log" model="ir.actions.act_window">
        <field name="name">Audit logs</field>
        <field name="res_model">gara.audit.log</field>
        <field name="view_mode">tree</field>
    </record>
</odoo>
