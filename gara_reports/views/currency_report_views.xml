<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_gara_foreign_currency_report_tree" model="ir.ui.view">
        <field name="name">gara.foreign.currency.report.tree</field>
        <field name="model">gara.foreign.currency.report</field>
        <field name="arch" type="xml">
            <tree create="0" edit="0" delete="0">
                <field name="date"/>
                <field name="currency_id"/>
                <field name="partner_id"/>
                <field name="account_id"/>
                <field name="account_type"/>
                <field name="move_id"/>
                <field name="journal_id"/>
                <field name="amount_currency" sum="Amount Currency"/>
                <field name="amount_residual_currency" sum="Residual Currency"/>
                <field name="foreign_receivable" sum="Foreign Receivable"/>
                <field name="foreign_payable" sum="Foreign Payable"/>
                <field name="balance" sum="Company Balance"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </tree>
        </field>
    </record>

    <record id="view_gara_foreign_currency_report_pivot" model="ir.ui.view">
        <field name="name">gara.foreign.currency.report.pivot</field>
        <field name="model">gara.foreign.currency.report</field>
        <field name="arch" type="xml">
            <pivot>
                <field name="date" type="row" interval="month"/>
                <field name="currency_id" type="row"/>
                <field name="partner_id" type="row"/>
                <field name="amount_currency" type="measure"/>
                <field name="amount_residual_currency" type="measure"/>
                <field name="foreign_receivable" type="measure"/>
                <field name="foreign_payable" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="view_gara_foreign_currency_report_search" model="ir.ui.view">
        <field name="name">gara.foreign.currency.report.search</field>
        <field name="model">gara.foreign.currency.report</field>
        <field name="arch" type="xml">
            <search>
                <field name="currency_id"/>
                <field name="partner_id"/>
                <field name="account_id"/>
                <filter name="receivable" string="Receivable" domain="[('account_type', '=', 'asset_receivable')]"/>
                <filter name="payable" string="Payable" domain="[('account_type', '=', 'liability_payable')]"/>
                <group expand="0" string="Group By">
                    <filter name="group_currency" string="Currency" context="{'group_by': 'currency_id'}"/>
                    <filter name="group_partner" string="Partner" context="{'group_by': 'partner_id'}"/>
                    <filter name="group_date" string="Month" context="{'group_by': 'date:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_gara_foreign_currency_report" model="ir.actions.act_window">
        <field name="name">Tiền gửi / công nợ ngoại tệ</field>
        <field name="res_model">gara.foreign.currency.report</field>
        <field name="view_mode">tree,pivot</field>
        <field name="search_view_id" ref="view_gara_foreign_currency_report_search"/>
        <field name="context">{'search_default_group_currency': 1}</field>
    </record>
</odoo>
