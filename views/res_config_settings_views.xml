<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="res_config_settings_view_form_booking_calendar" model="ir.ui.view">
            <field name="name">res.config.settings.view.form.inherit.booking_calendar</field>
            <field name="model">res.config.settings</field>
            <field name="inherit_id" ref="spa.res_config_settings_view_form"/>
            <field name="arch" type="xml">
                <xpath expr="//block[@id='spa_setting']" position="inside">
                    <setting string="Nhắc nhân viên trước (giờ) khi có lịch đặt dịch vụ sắp tới">
                        <div class="text-muted content-group mt16">
                            <field name="booking_reminder_hours_before" class="text-right" style="width: 6rem;"/>
                        </div>
                    </setting>
                    <setting string="Lịch đặt: giờ bắt đầu hiển thị">
                        <div class="text-muted content-group mt16">
                            <field name="spa_calendar_min_time" class="text-right" style="width: 8rem;"/>
                        </div>
                    </setting>
                    <setting string="Lịch đặt: giờ kết thúc hiển thị">
                        <div class="text-muted content-group mt16">
                            <field name="spa_calendar_max_time" class="text-right" style="width: 8rem;"/>
                        </div>
                    </setting>
                    <setting string="Lịch đặt: độ cao mỗi giờ (px)">
                        <div class="text-muted content-group mt16">
                            <field name="spa_calendar_pixels_per_hour" class="text-right" style="width: 6rem;"/>
                        </div>
                    </setting>
                    <setting string="Màu lịch: Đặt lịch">
                        <div class="text-muted content-group mt16 d-flex flex-wrap align-items-center gap-3">
                            <div class="d-flex align-items-center gap-2">
                                <span class="text-muted">Nền</span>
                                <field name="booking_calendar_hex_color_draft" class="text-right" style="width: 8rem;" placeholder="#5e5ce6"/>
                            </div>
                            <div class="d-flex align-items-center gap-2">
                                <span class="text-muted">Chữ</span>
                                <field name="booking_calendar_hex_text_color_draft" class="text-right" style="width: 8rem;" placeholder="#fff"/>
                            </div>
                        </div>
                    </setting>
                    <setting string="Màu lịch: Đã xác nhận">
                        <div class="text-muted content-group mt16 d-flex flex-wrap align-items-center gap-3">
                            <div class="d-flex align-items-center gap-2">
                                <span class="text-muted">Nền</span>
                                <field name="booking_calendar_hex_color_confirmed" class="text-right" style="width: 8rem;" placeholder="#2a9d8f"/>
                            </div>
                            <div class="d-flex align-items-center gap-2">
                                <span class="text-muted">Chữ</span>
                                <field name="booking_calendar_hex_text_color_confirmed" class="text-right" style="width: 8rem;" placeholder="#000"/>
                            </div>
                        </div>
                    </setting>
                    <setting string="Màu lịch: Đang phục vụ">
                        <div class="text-muted content-group mt16 d-flex flex-wrap align-items-center gap-3">
                            <div class="d-flex align-items-center gap-2">
                                <span class="text-muted">Nền</span>
                                <field name="booking_calendar_hex_color_doing" class="text-right" style="width: 8rem;" placeholder="#f4a261"/>
                            </div>
                            <div class="d-flex align-items-center gap-2">
                                <span class="text-muted">Chữ</span>
                                <field name="booking_calendar_hex_text_color_doing" class="text-right" style="width: 8rem;" placeholder="#000"/>
                            </div>
                        </div>
                    </setting>
                    <setting string="Màu lịch: Đã hoàn thành">
                        <div class="text-muted content-group mt16 d-flex flex-wrap align-items-center gap-3">
                            <div class="d-flex align-items-center gap-2">
                                <span class="text-muted">Nền</span>
                                <field name="booking_calendar_hex_color_done" class="text-right" style="width: 8rem;" placeholder="#457b9d"/>
                            </div>
                            <div class="d-flex align-items-center gap-2">
                                <span class="text-muted">Chữ</span>
                                <field name="booking_calendar_hex_text_color_done" class="text-right" style="width: 8rem;" placeholder="#fff"/>
                            </div>
                        </div>
                    </setting>
                    <setting string="Màu lịch: Đã hủy">
                        <div class="text-muted content-group mt16 d-flex flex-wrap align-items-center gap-3">
                            <div class="d-flex align-items-center gap-2">
                                <span class="text-muted">Nền</span>
                                <field name="booking_calendar_hex_color_cancel" class="text-right" style="width: 8rem;" placeholder="#e63946"/>
                            </div>
                            <div class="d-flex align-items-center gap-2">
                                <span class="text-muted">Chữ</span>
                                <field name="booking_calendar_hex_text_color_cancel" class="text-right" style="width: 8rem;" placeholder="#fff"/>
                            </div>
                        </div>
                    </setting>

                    <setting string="Màu đặc biệt (chỉ áp dụng trạng thái Đặt lịch)">
                        <div class="text-muted content-group mt16 d-flex flex-column gap-2">
                            <div class="d-flex flex-wrap align-items-center gap-2">
                                <span class="text-muted" style="min-width: 14rem;">Danh mục sản phẩm: Triệt lông</span>
                                <field name="booking_calendar_hair_removal_category_id" options="{'no_create': True}" style="min-width: 16rem;"/>
                                <span class="small text-muted">Áp dụng cho cả danh mục con</span>
                            </div>
                            <div class="d-flex flex-wrap align-items-center gap-2">
                                <span class="text-muted" style="min-width: 14rem;">Lịch cố định hàng tuần</span>
                                <field name="booking_calendar_hex_color_draft_weekly" class="text-right" style="width: 8rem;" placeholder="#3E51BA"/>
                                <span class="text-muted ms-2">Chữ</span>
                                <field name="booking_calendar_hex_text_color_draft_weekly" class="text-right" style="width: 8rem;" placeholder="(auto)"/>
                            </div>
                            <div class="d-flex flex-wrap align-items-center gap-2">
                                <span class="text-muted" style="min-width: 14rem;">Khách mới đặt (ngày tạo quá khứ)</span>
                                <field name="booking_calendar_hex_color_draft_past_created" class="text-right" style="width: 8rem;" placeholder="#33B577"/>
                                <span class="text-muted ms-2">Chữ</span>
                                <field name="booking_calendar_hex_text_color_draft_past_created" class="text-right" style="width: 8rem;" placeholder="(auto)"/>
                            </div>
                            <div class="d-flex flex-wrap align-items-center gap-2">
                                <span class="text-muted" style="min-width: 14rem;">Họp/đào tạo/mẫu (Không trừ buổi)</span>
                                <field name="booking_calendar_hex_color_draft_non_session" class="text-right" style="width: 8rem;" placeholder="#D71629"/>
                                <span class="text-muted ms-2">Chữ</span>
                                <field name="booking_calendar_hex_text_color_draft_non_session" class="text-right" style="width: 8rem;" placeholder="(auto)"/>
                            </div>
                            <div class="d-flex flex-wrap align-items-center gap-2">
                                <span class="text-muted" style="min-width: 14rem;">Triệt lông</span>
                                <field name="booking_calendar_hex_color_draft_hair_removal" class="text-right" style="width: 8rem;" placeholder="#F44F15"/>
                                <span class="text-muted ms-2">Chữ</span>
                                <field name="booking_calendar_hex_text_color_draft_hair_removal" class="text-right" style="width: 8rem;" placeholder="(auto)"/>
                            </div>
                            <div class="d-flex flex-wrap align-items-center gap-2">
                                <span class="text-muted" style="min-width: 14rem;">Dịch vụ chuyên gia</span>
                                <field name="booking_calendar_hex_color_draft_expert_only" class="text-right" style="width: 8rem;" placeholder="#8E24AC"/>
                                <span class="text-muted ms-2">Chữ</span>
                                <field name="booking_calendar_hex_text_color_draft_expert_only" class="text-right" style="width: 8rem;" placeholder="(auto)"/>
                            </div>
                            <div class="small text-muted mt-1">
                                Ưu tiên: Không trừ buổi → Đặt theo tuần → Triệt lông → Chuyên gia → Ngày tạo quá khứ.
                            </div>
                        </div>
                    </setting>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
