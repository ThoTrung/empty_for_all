<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="res_config_settings_view_form_spa_zalo_oa" model="ir.ui.view">
            <field name="name">res.config.settings.view.form.inherit.spa_zalo_oa</field>
            <field name="model">res.config.settings</field>
            <field name="inherit_id" ref="spa.res_config_settings_view_form"/>
            <field name="arch" type="xml">
                <xpath expr="//block[@id='spa_setting']" position="inside">
                    <setting string="Zalo ZNS: Nhắc lịch hẹn khách hàng"
                             groups="spa.group_clic_admin"
                             help="Tự động gửi tin nhắc lịch cho khách hàng qua Zalo OA (ZNS).">
                        <field name="spa_zalo_reminder_enabled"/>
                        <div class="content-group mt16" invisible="not spa_zalo_reminder_enabled">
                            <div class="row mt8">
                                <label for="spa_zalo_reminder_template_id" string="Template ID nhắc lịch" class="col-lg-4 o_light_label"/>
                                <field name="spa_zalo_reminder_template_id" style="width: 14rem;"/>
                            </div>
                            <div class="row mt8">
                                <label for="spa_zalo_reminder_offset_value" string="Nhắc trước" class="col-lg-4 o_light_label"/>
                                <field name="spa_zalo_reminder_offset_value" class="text-right" style="width: 5rem;"/>
                                <field name="spa_zalo_reminder_offset_unit" style="width: 7rem;"/>
                            </div>
                            <div class="row mt8">
                                <label for="spa_zalo_batch_size" string="Số tin / lượt cron" class="col-lg-4 o_light_label"/>
                                <field name="spa_zalo_batch_size" class="text-right" style="width: 5rem;"/>
                            </div>
                            <div class="row mt8">
                                <label for="spa_zalo_max_retry" string="Số lần thử lại tối đa" class="col-lg-4 o_light_label"/>
                                <field name="spa_zalo_max_retry" class="text-right" style="width: 5rem;"/>
                            </div>
                            <div class="row mt8">
                                <label for="spa_zalo_whitelist_enabled" string="Chế độ whitelist (test)" class="col-lg-4 o_light_label"/>
                                <field name="spa_zalo_whitelist_enabled"/>
                            </div>
                            <div class="row mt8" invisible="not spa_zalo_whitelist_enabled">
                                <label for="spa_zalo_whitelist_phones" string="SĐT whitelist (phân tách dấu phẩy)" class="col-lg-4 o_light_label"/>
                                <field name="spa_zalo_whitelist_phones" style="width: 24rem;"/>
                            </div>
                            <div class="row mt8">
                                <label for="spa_zalo_oa_account_id" string="Tài khoản OA đang dùng" class="col-lg-4 o_light_label"/>
                                <field name="spa_zalo_oa_account_id"/>
                            </div>
                            <div class="text-muted mt8">
                                Cấu hình App ID / Secret / Refresh Token tại menu
                                <b>Zalo OA &gt; Tài khoản Zalo OA</b>.
                            </div>
                        </div>
                    </setting>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
