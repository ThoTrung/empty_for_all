<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_spa_service_booking_search" model="ir.ui.view">
            <field name="name">spa.service.booking.search</field>
            <field name="model">spa.service.booking</field>
            <field name="arch" type="xml">
                <search>
                    <field name="name"/>
                    <field name="booking_kind"/>
                    <field name="partner_id"/>
                    <field name="product_internal_ref"/>
                    <field name="display_is_calendar_parent" invisible="1"/>
                    <field name="staff_ids"/>
                    <field name="bed_id"/>
                     <filter string="Đặt lịch" name="draft" domain="[('state', '=', 'draft')]"/>
                    <filter string="Đã xác nhận" name="confirmed" domain="[('state', '=', 'confirmed')]"/>
                    <filter string="Đang phục vụ" name="doing" domain="[('state', '=', 'doing')]"/>
                    <filter string="Đã hủy" name="cancel" domain="[('state', '=', 'cancel')]"/>
                    <separator/>
                    <filter string="Lịch của tôi" name="my_bookings" domain="[('staff_ids', 'in', [uid])]"/>
                    <separator/>
                    <filter string="Ngày bắt đầu" name="start_date" date="start_datetime"/>
                    <group expand="0" string="Nhóm theo">
                        <filter string="Nhân viên" name="group_staff" context="{'group_by': 'staff_ids'}"/>
                    </group>
                </search>
            </field>
        </record>
        <record id="view_spa_service_booking_calendar" model="ir.ui.view">
            <field name="name">spa.service.booking.calendar</field>
            <field name="model">spa.service.booking</field>
            <field name="arch" type="xml">
                <calendar date_start="display_start_datetime"
                          date_stop="display_end_datetime"
                          string="Lịch đặt dịch vụ"
                          color="state_calendar_hex_color"
                          event_limit="15"
                          quick_create="false"
                          create_name_field="calendar_event_title"
                          event_open_popup="1">
                    <field name="name"/>
                    <field name="state" string="Trạng thái lịch" filters="1" expand="1"/>
                    <field name="booking_kind" string="Loại thẻ (booking_type)" filters="1"/>
                    <field name="partner_id" string="Mã KH - Tên KH"/>
                    <field name="non_session_offering_id" string="Loại hoạt động" invisible="booking_kind != 'non_session'"/>
                    <field name="card_id" string="Thẻ" invisible="booking_kind != 'card'"/>
                    <field name="card_total_sessions" string="Tổng số buổi" invisible="booking_kind != 'card'"/>
                    <field name="card_available_for_booking" string="Còn cho đặt lịch" invisible="booking_kind != 'card'"/>
                    <field name="staff_ids" string="Nhân viên phụ trách"/>
                    <field name="bed_id" string="Giường / Máy"/>
                    <field name="staff_ids" invisible="1"/>
                    <field name="staff_level_filter" filters="1" invisible="1"/>
                    <field name="state_calendar_hex_color" invisible="1"/>
                    <field name="state_calendar_hex_text_color" invisible="1"/>
                    <field name="draft_special_hex_color" invisible="1"/>
                    <field name="draft_special_hex_text_color" invisible="1"/>
                    <field name="bed_calendar_color" invisible="1"/>
                    <field name="duration" invisible="1"/>
                    <field name="display_start_datetime" invisible="1"/>
                    <field name="display_end_datetime" invisible="1"/>
                </calendar>
            </field>
        </record>
        <record id="view_spa_service_booking_tree" model="ir.ui.view">
            <field name="name">spa.service.booking.tree</field>
            <field name="model">spa.service.booking</field>
            <field name="arch" type="xml">
                <tree default_order="start_datetime desc, id desc"
                      decoration-muted="state == 'cancel'"
                      decoration-success="state == 'done'"
                      decoration-info="state == 'confirmed'">
                    <field name="name" optional="hide"/>
                    <field name="booking_kind" optional="show"/>
                    <field name="partner_customer_code" optional="show"/>
                    <field name="partner_id"/>
                    <field name="partner_phone" optional="show"/>
                    <field name="product_internal_ref"/>
                    <field name="display_calendar_service_id" optional="hide"/>
                    <field name="start_datetime"/>
                    <field name="end_datetime" optional="hide"/>
                    <field name="display_end_datetime" optional="hide"/>
                    <field name="staff_ids" widget="many2many_tags"/>
                    <field name="bed_id"/>
                    <field name="state" widget="badge"/>
                    <field name="reminder_sent" optional="hide"/>
                </tree>
            </field>
        </record>
        <record id="view_spa_service_booking_form" model="ir.ui.view">
            <field name="name">spa.service.booking.form</field>
            <field name="model">spa.service.booking</field>
            <field name="arch" type="xml">
                <form>
                    <header>
                        <field name="state" widget="statusbar"/>
                        <button name="action_enable_recurring"
                                string="Đặt theo tuần"
                                type="object"
                                class="oe_highlight"
                                groups="spa.group_spa_staff"
                                invisible="is_locked or is_recurring_child or recurring_is_active or booking_kind != 'card'"/>
                        <button name="action_cancel_recurring"
                                string="Hủy đặt lịch theo tuần"
                                type="object"
                                class="btn-danger"
                                groups="spa.group_spa_staff"
                                invisible="is_locked or is_recurring_child or not recurring_is_active or booking_kind != 'card'"/>
                        <button name="action_confirm" string="Xác nhận" type="object"
                                groups="spa.group_spa_staff"
                                invisible="is_locked or state != 'draft'" class="btn btn-warning"/>
                        <button name="action_doing" string="Phục vụ" type="object" class="btn btn-success"
                                groups="spa.group_spa_staff,spa.group_spa_booking_operator"
                                invisible="is_locked or state not in ('draft', 'confirmed')"/>
                        <button name="action_done" string="Hoàn thành" type="object" class="btn btn-info"
                                groups="spa.group_spa_staff,spa.group_spa_booking_operator"
                                invisible="is_locked or state not in ('confirmed', 'doing')"/>
                        <button name="action_cancel" string="Hủy" type="object" class="btn btn-danger"
                                groups="spa.group_spa_staff"
                                invisible="is_locked or state not in ('draft', 'confirmed')"/>
                        <button name="action_draft" string="Đặt lại Đã xác nhận" type="object"
                                groups="spa.group_spa_staff"
                                invisible="is_locked or state != 'cancel'"/>
                    </header>
                    <sheet>
                        <div class="oe_button_box" name="button_box">
                            <button name="action_open_child_bookings"
                                    type="object"
                                    class="oe_stat_button"
                                    icon="fa-sitemap"
                                    groups="spa.group_spa_staff,spa.group_spa_staff_readonly,spa.group_spa_booking_operator"
                                    invisible="not display_is_calendar_parent">
                                <field name="child_booking_ids" widget="statinfo" string="Dịch vụ con"/>
                            </button>
                            <button name="action_open_parent_booking"
                                    type="object"
                                    class="oe_stat_button"
                                    icon="fa-level-up"
                                    groups="spa.group_spa_staff,spa.group_spa_staff_readonly,spa.group_spa_booking_operator"
                                    invisible="not parent_booking_id">
                                <span>Booking cha</span>
                            </button>
                        </div>
                        <div class="oe_title">
                            <h1><field name="name" readonly="1" class="oe_inline"/></h1>
                        </div>
                        <group>
                            <group>
                                <field name="partner_id" context="{'form_view_ref': 'spa.view_partner_form_spa'}" required="1" readonly="is_locked"/>
                                <field name="booking_kind" readonly="is_locked"/>
                                <field name="booking_board" invisible="1"/>
                                <field name="parent_booking_id" invisible="1"/>
                                <field name="display_is_calendar_parent" invisible="1"/>
                                <field name="card_id"
                                       domain="[
                                         ('partner_id', '=', partner_id),
                                         ('available_for_booking', '&gt;', 0),
                                         ('state', '=', 'active'),
                                         ('product_id.spa_required_staff_level_id.level_group', 'in', context.get('spa_allowed_staff_levels', ['regular','spec_b','spec_a','senior','expert','doctor']))
                                       ]"
                                       invisible="booking_kind != 'card'"
                                       required="booking_kind == 'card'"
                                       readonly="is_locked"/>
                                <field name="non_session_offering_id" options="{'no_create': True}" invisible="booking_kind != 'non_session'" required="booking_kind == 'non_session'" readonly="is_locked"/>
                                <field name="card_total_sessions" optional="show" readonly="1" invisible="booking_kind != 'card'"/>
                                <field name="card_available_for_booking" optional="show" readonly="1" invisible="booking_kind != 'card'"/>
                                <field name="product_id" invisible="1"/>
                                <field name="display_calendar_service_id" invisible="1"/>
                                <field name="start_datetime" required="1" readonly="is_locked"/>
                                <field name="duration" required="1" readonly="is_locked or is_composite_booking"/>
                                <field name="display_end_datetime" readonly="1" force_save="1"/>
                                <field name="end_datetime" invisible="1"/>
                                <field name="staff_ids"
                                       widget="many2many_tags"
                                       domain="[
                                         ('share', '=', False),
                                         ('spa_staff_level_id.level_group', 'in', context.get('spa_allowed_staff_levels', ['regular','spec_b','spec_a','senior','expert','doctor']))
                                       ]"
                                       readonly="is_locked"
                                       invisible="is_composite_booking"/>
                                <field name="staff_outside_shift"
                                       readonly="is_locked"
                                       invisible="is_composite_booking"/>
                                <field name="staff_outside_shift_warning_html"
                                       readonly="1"
                                       invisible="is_composite_booking or not staff_outside_shift_warning_html"
                                       colspan="2"/>
                                <field name="staff_outside_shift_user_ids"
                                       widget="many2many_tags"
                                       readonly="is_locked"
                                       invisible="is_composite_booking"
                                       optional="hide"/>
                                <field name="display_composite_staff_ids"
                                       widget="many2many_tags"
                                       readonly="1"
                                       invisible="not is_composite_booking"/>
                                <field name="suggested_staff_html" readonly="1" invisible="is_composite_booking"/>
                                <field name="bed_id" readonly="is_locked"/>
                                <field name="recurring_parent_id" invisible="not is_recurring_child" readonly="1"/>
                            </group>
                            <group col="4">
                                <field name="session_id" options="{'open': True}"/>
                                <field name="reminder_sent" readonly="1"/>
                                <field name="note" colspan="4" readonly="is_locked"/>
                                <field name="calendar_note" colspan="4" readonly="is_locked" placeholder="Ghi chú hiển thị trên lịch (sau tên KH)"/>
                                <field name="is_locked" invisible="1"/>
                                <field name="is_composite_booking" invisible="1"/>
                                <field name="is_recurring_child" invisible="1"/>
                                <field name="recurring_enabled" invisible="1"/>
                                <field name="recurring_is_active" invisible="1"/>
                                <separator string="Đặt lịch theo ngày trong tuần"
                                           class="text-danger text-medium"
                                           invisible="is_recurring_child or not recurring_enabled or booking_kind != 'card'"/>
                                <field name="recurring_mon" invisible="is_recurring_child or not recurring_enabled or booking_kind != 'card'"/>
                                <field name="recurring_tue" invisible="is_recurring_child or not recurring_enabled or booking_kind != 'card'"/>
                                <field name="recurring_wed" invisible="is_recurring_child or not recurring_enabled or booking_kind != 'card'"/>
                                <field name="recurring_thu" invisible="is_recurring_child or not recurring_enabled or booking_kind != 'card'"/>
                                <field name="recurring_fri" invisible="is_recurring_child or not recurring_enabled or booking_kind != 'card'"/>
                                <field name="recurring_sat" invisible="is_recurring_child or not recurring_enabled or booking_kind != 'card'"/>
                                <field name="recurring_sun" invisible="is_recurring_child or not recurring_enabled or booking_kind != 'card'"/>
                                <field name="recurring_copy_staff"
                                       invisible="is_recurring_child or not recurring_enabled or booking_kind != 'card'"/>
                                <button name="action_confirm_recurring"
                                        colspan="4"
                                        string="Xác nhận đặt lịch theo tuần"
                                        type="object"
                                        class="btn btn-primary px-4"
                                        groups="spa.group_spa_staff"
                                        invisible="is_recurring_child or not recurring_enabled or booking_kind != 'card'"/>
                            </group>
                        </group>
                        <group string="Dịch vụ đã thêm" colspan="2" invisible="not display_is_calendar_parent">
                            <div colspan="2">
                                <button name="action_add_child_service_booking_before"
                                        type="object"
                                        class="btn btn-success p-1 mx-2"
                                        string="+ Thêm dịch vụ (trước)"
                                        groups="spa.group_spa_staff"
                                        invisible="is_locked"/>
                                <button name="action_add_child_service_booking"
                                        type="object"
                                        class="btn btn-info p-1 mx-2"
                                        string="+ Thêm dịch vụ (sau)"
                                        groups="spa.group_spa_staff"
                                        invisible="is_locked"/>
                            </div>
                            <field name="child_booking_ids" nolabel="1" colspan="2"
                                   context="{'default_parent_booking_id': id}">
                                <tree default_order="child_sequence,id" create="false" edit="false" delete="false">
                                    <field name="child_sequence" string="#" optional="show"/>
                                    <field name="name" string="Mã"/>
                                    <field name="booking_kind" optional="hide"/>
                                    <field name="card_id" optional="show" invisible="booking_kind != 'card'"/>
                                    <field name="non_session_offering_id" optional="show" invisible="booking_kind != 'non_session'"/>
                                    <field name="start_datetime" string="Bắt đầu"/>
                                    <field name="duration" string="Phút" optional="hide"/>
                                    <field name="end_datetime" string="Kết thúc"/>
                                    <field name="staff_ids" widget="many2many_tags" optional="hide"/>
                                    <field name="state" widget="badge" optional="show"/>
                                </tree>
                            </field>
                        </group>
                        <group string="Dịch vụ con (dịch vụ tổng)" colspan="2" invisible="not is_composite_booking">
                            <field name="booking_line_ids" nolabel="1" colspan="2" class="o_spa_bundle_steps_field">
                                <tree editable="bottom" default_order="sequence,id" class="o_spa_bundle_steps_tree">
                                    <field name="booking_id" column_invisible="1"/>
                                    <field name="sequence" widget="handle"/>
                                    <field name="product_internal_ref" readonly="1"/>
                                    <field name="product_id" optional="hide"/>
                                    <button name="action_open_assign_staff_modal"
                                            type="object"
                                            string="Chọn NV"
                                            groups="spa.group_spa_staff"
                                            class="btn btn-secondary"
                                            icon="fa-user"/>
                                    <field name="staff_id"
                                           domain="[('share', '=', False)]"/>
                                    <field name="staff_outside_shift" optional="show"/>
                                    <field name="start_datetime"/>
                                    <field name="duration_minutes"/>
                                    <field name="end_datetime"/>
                                </tree>
                            </field>
                        </group>
                        <notebook>
                            <page string="Chatter" name="chatter">
                                <field name="message_follower_ids" widget="mail_followers"/>
                                <field name="activity_ids" widget="mail_activity"/>
                                <field name="message_ids" widget="mail_thread"/>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>
        <record id="action_spa_service_booking" model="ir.actions.act_window">
            <field name="name">Đặt lịch dịch vụ</field>
            <field name="res_model">spa.service.booking</field>
            <field name="view_mode">calendar,tree,form</field>
            <field name="view_id" ref="view_spa_service_booking_calendar"/>
            <field name="search_view_id" ref="view_spa_service_booking_search"/>
            <field name="domain">[('display_is_calendar_parent', '=', True)]</field>
            <field name="context">{'search_default_confirmed': 0}</field>
        </record>
        <record id="action_spa_service_booking_doctor" model="ir.actions.act_window">
            <field name="name">Đặt lịch (Bác sĩ)</field>
            <field name="res_model">spa.service.booking</field>
            <field name="view_mode">calendar,tree,form</field>
            <field name="view_id" ref="view_spa_service_booking_calendar"/>
            <field name="search_view_id" ref="view_spa_service_booking_search"/>
            <field name="domain">[('display_is_calendar_parent', '=', True), ('booking_board', '=', 'doctor')]</field>
            <field name="context">{'spa_allowed_staff_levels': ['doctor'], 'default_booking_board': 'doctor'}</field>
        </record>
        <record id="action_spa_service_booking_specialist" model="ir.actions.act_window">
            <field name="name">Đặt lịch (Chuyên viên/Chuyên gia)</field>
            <field name="res_model">spa.service.booking</field>
            <field name="view_mode">calendar,tree,form</field>
            <field name="view_id" ref="view_spa_service_booking_calendar"/>
            <field name="search_view_id" ref="view_spa_service_booking_search"/>
            <field name="domain">[('display_is_calendar_parent', '=', True), ('booking_board', '=', 'specialist')]</field>
            <field name="context">{'spa_allowed_staff_levels': ['spec_b','spec_a','senior','expert'], 'default_booking_board': 'specialist'}</field>
        </record>
        <record id="view_spa_service_booking_calendar_operator" model="ir.ui.view">
            <field name="name">spa.service.booking.calendar.operator</field>
            <field name="model">spa.service.booking</field>
            <field name="inherit_id" ref="view_spa_service_booking_calendar"/>
            <field name="mode">primary</field>
            <field name="priority">99</field>
            <field name="arch" type="xml">
                <data>
                    <calendar position="attributes">
                        <attribute name="create">0</attribute>
                        <attribute name="delete">0</attribute>
                    </calendar>
                    <xpath expr="//field[@name='display_start_datetime']" position="attributes">
                        <attribute name="readonly">1</attribute>
                    </xpath>
                </data>
            </field>
        </record>
        <record id="view_spa_service_booking_tree_operator" model="ir.ui.view">
            <field name="name">spa.service.booking.tree.operator</field>
            <field name="model">spa.service.booking</field>
            <field name="inherit_id" ref="view_spa_service_booking_tree"/>
            <field name="mode">primary</field>
            <field name="priority">99</field>
            <field name="arch" type="xml">
                <tree position="attributes">
                    <attribute name="create">0</attribute>
                    <attribute name="edit">0</attribute>
                    <attribute name="delete">0</attribute>
                </tree>
            </field>
        </record>
        <record id="view_spa_service_booking_form_operator" model="ir.ui.view">
            <field name="name">spa.service.booking.form.operator</field>
            <field name="model">spa.service.booking</field>
            <field name="inherit_id" ref="view_spa_service_booking_form"/>
            <field name="mode">primary</field>
            <field name="priority">99</field>
            <field name="arch" type="xml">
                <data>
                <form position="attributes">
                    <attribute name="create">0</attribute>
                    <attribute name="edit">1</attribute>
                    <attribute name="delete">0</attribute>
                </form>
                <xpath expr="//field[@name='partner_id']" position="attributes">
                    <attribute name="readonly">1</attribute>
                </xpath>
                <xpath expr="//field[@name='booking_kind']" position="attributes">
                    <attribute name="readonly">1</attribute>
                </xpath>
                <xpath expr="//field[@name='card_id']" position="attributes">
                    <attribute name="readonly">1</attribute>
                </xpath>
                <xpath expr="//field[@name='non_session_offering_id']" position="attributes">
                    <attribute name="readonly">1</attribute>
                </xpath>
                <xpath expr="//field[@name='start_datetime']" position="attributes">
                    <attribute name="readonly">1</attribute>
                </xpath>
                <xpath expr="//field[@name='duration']" position="attributes">
                    <attribute name="readonly">1</attribute>
                </xpath>
                <xpath expr="//field[@name='bed_id']" position="attributes">
                    <attribute name="readonly">1</attribute>
                </xpath>
                <xpath expr="//field[@name='session_id']" position="attributes">
                    <attribute name="readonly">1</attribute>
                </xpath>
                <xpath expr="//field[@name='note']" position="attributes">
                    <attribute name="readonly">1</attribute>
                </xpath>
                <xpath expr="//field[@name='calendar_note']" position="attributes">
                    <attribute name="readonly">1</attribute>
                </xpath>
                <xpath expr="//field[@name='recurring_mon']" position="attributes">
                    <attribute name="readonly">1</attribute>
                </xpath>
                <xpath expr="//field[@name='recurring_tue']" position="attributes">
                    <attribute name="readonly">1</attribute>
                </xpath>
                <xpath expr="//field[@name='recurring_wed']" position="attributes">
                    <attribute name="readonly">1</attribute>
                </xpath>
                <xpath expr="//field[@name='recurring_thu']" position="attributes">
                    <attribute name="readonly">1</attribute>
                </xpath>
                <xpath expr="//field[@name='recurring_fri']" position="attributes">
                    <attribute name="readonly">1</attribute>
                </xpath>
                <xpath expr="//field[@name='recurring_sat']" position="attributes">
                    <attribute name="readonly">1</attribute>
                </xpath>
                <xpath expr="//field[@name='recurring_sun']" position="attributes">
                    <attribute name="readonly">1</attribute>
                </xpath>
                <xpath expr="//field[@name='booking_line_ids']/tree" position="attributes">
                    <attribute name="create">false</attribute>
                    <attribute name="delete">false</attribute>
                </xpath>
                <xpath expr="//field[@name='booking_line_ids']/tree/field[@name='sequence']" position="attributes">
                    <attribute name="readonly">1</attribute>
                </xpath>
                <xpath expr="//field[@name='booking_line_ids']/tree/field[@name='product_id']" position="attributes">
                    <attribute name="readonly">1</attribute>
                </xpath>
                <xpath expr="//field[@name='booking_line_ids']/tree/field[@name='start_datetime']" position="attributes">
                    <attribute name="readonly">1</attribute>
                </xpath>
                <xpath expr="//field[@name='booking_line_ids']/tree/field[@name='duration_minutes']" position="attributes">
                    <attribute name="readonly">1</attribute>
                </xpath>
                <xpath expr="//field[@name='booking_line_ids']/tree/field[@name='end_datetime']" position="attributes">
                    <attribute name="readonly">1</attribute>
                </xpath>
                <xpath expr="//button[@name='action_open_assign_staff_modal']" position="attributes">
                    <attribute name="groups">spa.group_spa_staff,spa.group_spa_booking_operator</attribute>
                </xpath>
                </data>
            </field>
        </record>
        <record id="action_spa_service_booking_operator" model="ir.actions.act_window">
            <field name="name">Lịch phục vụ</field>
            <field name="res_model">spa.service.booking</field>
            <field name="view_mode">calendar,tree,form</field>
            <field name="domain">[('display_is_calendar_parent', '=', True), ('state', 'in', ('confirmed', 'doing', 'done'))]</field>
            <field name="context">{}</field>
        </record>
        <record id="action_spa_service_booking_operator_view_calendar" model="ir.actions.act_window.view">
            <field name="sequence">1</field>
            <field name="view_mode">calendar</field>
            <field name="view_id" ref="view_spa_service_booking_calendar_operator"/>
            <field name="act_window_id" ref="action_spa_service_booking_operator"/>
        </record>
        <record id="action_spa_service_booking_operator_view_tree" model="ir.actions.act_window.view">
            <field name="sequence">2</field>
            <field name="view_mode">tree</field>
            <field name="view_id" ref="view_spa_service_booking_tree_operator"/>
