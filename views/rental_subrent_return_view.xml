<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_rental_subrent_return_tree" model="ir.ui.view">
        <field name="name">rental.subrent.return.tree</field>
        <field name="model">rental.subrent.return</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="subrent_contract_id"/>
                <field name="policy_code"/>
                <field name="supplier_id"/>
                <field name="date"/>
                <field name="state"/>
            </tree>
        </field>
    </record>
    <record id="view_rental_subrent_return_form" model="ir.ui.view">
        <field name="name">rental.subrent.return.form</field>
        <field name="model">rental.subrent.return</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_confirm" string="Xác nhận trả NCC" type="object" class="oe_highlight" invisible="state != 'draft'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="subrent_contract_id"/>
                            <field name="policy_code" readonly="1"/>
                            <field name="supplier_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group>
                            <field name="date"/>
                        </group>
                    </group>
                    <field name="line_ids">
                        <tree editable="bottom">
                            <field name="policy_code" column_invisible="1"/>
                            <field name="lot_id" required="policy_code in ('tracked', 'pass_through')"
                                   column_invisible="policy_code == 'simple'"/>
                            <field name="product_id" required="1"/>
                            <field name="qty"/>
                        </tree>
                    </field>
                    <field name="picking_ids" widget="many2many_tags" readonly="1"/>
                    <field name="note"/>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_rental_subrent_return" model="ir.actions.act_window">
        <field name="name">Trả NCC</field>
        <field name="res_model">rental.subrent.return</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Tạo phiếu trả NCC
            </p>
            <p>
                Ưu tiên tạo từ form <b>HĐ thuê ngoài</b> → tab <b>Nhập / Trả NCC</b>.
                Menu này vẫn dùng được để xem danh sách / tạo nhanh.
            </p>
        </field>
    </record>
</odoo>
