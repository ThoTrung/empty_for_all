<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_spa_zalo_oa_account_form" model="ir.ui.view">
        <field name="name">spa.zalo.oa.account.form</field>
        <field name="model">spa.zalo.oa.account</field>
        <field name="arch" type="xml">
            <form string="Tài khoản Zalo OA">
                <header>
                    <button name="action_refresh_token" type="object"
                            string="Làm mới token" class="btn-primary"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Lưu trữ" bg_color="bg-danger"
                            invisible="active"/>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="active"/>
                            <field name="app_id"/>
                            <field name="secret_key" password="True"/>
                            <field name="oa_id"/>
                        </group>
                        <group>
                            <field name="refresh_token" password="True"/>
                            <field name="access_token" readonly="1"/>
                            <field name="token_expiry" readonly="1"/>
                            <field name="last_refresh" readonly="1"/>
                            <field name="last_error" readonly="1"/>
                        </group>
                    </group>
                    <div class="text-muted">
                        Nhập App ID, App Secret và Refresh Token lấy từ Zalo OA Console,
                        sau đó bấm « Làm mới token ». Hệ thống tự làm mới định kỳ.
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_spa_zalo_oa_account_tree" model="ir.ui.view">
        <field name="name">spa.zalo.oa.account.tree</field>
        <field name="model">spa.zalo.oa.account</field>
        <field name="arch" type="xml">
            <tree string="Tài khoản Zalo OA">
                <field name="name"/>
                <field name="app_id"/>
                <field name="oa_id"/>
                <field name="token_expiry"/>
                <field name="last_refresh"/>
                <field name="active"/>
            </tree>
        </field>
    </record>

    <record id="action_spa_zalo_oa_account" model="ir.actions.act_window">
        <field name="name">Tài khoản Zalo OA</field>
        <field name="res_model">spa.zalo.oa.account</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
