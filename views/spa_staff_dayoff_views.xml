<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_spa_staff_dayoff_tree" model="ir.ui.view">
        <field name="name">spa.staff.dayoff.tree</field>
        <field name="model">spa.staff.dayoff</field>
        <field name="arch" type="xml">
            <tree string="Ngày nghỉ">
                <field name="employee_id"/>
                <field name="date_start"/>
                <field name="date_end"/>
                <field name="dayoff_type"/>
                <field name="name"/>
            </tree>
        </field>
    </record>
    <record id="view_spa_staff_dayoff_form" model="ir.ui.view">
        <field name="name">spa.staff.dayoff.form</field>
        <field name="model">spa.staff.dayoff</field>
        <field name="arch" type="xml">
            <form string="Ngày nghỉ">
                <sheet>
                    <group>
                        <field name="employee_id"/>
                        <field name="date_start"/>
                        <field name="date_end"/>
                        <field name="dayoff_type"/>
                        <field name="name"/>
                        <field name="note"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="action_spa_staff_dayoff" model="ir.actions.act_window">
        <field name="name">Ngày nghỉ nhân viên</field>
        <field name="res_model">spa.staff.dayoff</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
