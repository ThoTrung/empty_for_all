<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_rental_home_dashboard" model="ir.actions.client">
        <field name="name">Trang chủ</field>
        <field name="tag">rental_home_dashboard</field>
        <field name="target">current</field>
    </record>

    <!-- Người dùng có Home Action (Preferences > Action) đang trỏ về
         "Thống kê" (action mặc định cũ) thì chuyển sang "Trang chủ" mới,
         để đăng nhập vào thẳng màn hình lưới icon thay vì Thống kê. -->
    <function model="res.users" name="write">
        <value model="res.users"
               eval="obj().env['res.users'].search([('action_id', '=', ref('rental.action_rental_analytics_dashboard'))]).ids"/>
        <value eval="{'action_id': ref('rental.action_rental_home_dashboard')}"/>
    </function>

    <!-- Trợ giúp: placeholder cho tới khi có link YouTube/thông tin liên hệ
         thật — sau này chỉ cần đổi field url, không cần đổi cấu trúc. -->
    <record id="action_rental_help_placeholder" model="ir.actions.act_url">
        <field name="name">Trợ giúp</field>
        <field name="url">/rental/static/src/help/help_placeholder.html</field>
        <field name="target">new</field>
    </record>

    <!-- Đồng bộ bản dịch tiếng Việt (vi_VN) theo đúng nội dung mới nhất
         (en_US) cho các field từng bị lệch do có bản dịch cũ lưu riêng
         trước đây (Odoo không tự ghi đè bản dịch đã tồn tại khi source
         đổi nếu không set rõ ngôn ngữ). Đồng bộ cả arch view (sửa luôn
         "Phiếu giao - nhận VT" / "Bảng KL, giá trị thuê" nếu cùng bị lệch). -->
    <function model="ir.ui.view" name="write" context="{'lang': 'vi_VN'}">
        <value model="ir.ui.view" eval="[ref('rental.view_rental_contract_form')]"/>
        <value model="ir.ui.view" eval="{'arch_db': obj().env.ref('rental.view_rental_contract_form').with_context(lang='en_US').arch_db}"/>
    </function>
    <function model="ir.ui.menu" name="write" context="{'lang': 'vi_VN'}">
        <value model="ir.ui.menu" eval="[ref('rental.menu_product_template')]"/>
        <value model="ir.ui.menu" eval="{'name': obj().env.ref('rental.menu_product_template').with_context(lang='en_US').name}"/>
    </function>
    <function model="ir.ui.menu" name="write" context="{'lang': 'vi_VN'}">
        <value model="ir.ui.menu" eval="[ref('rental.menu_product_product')]"/>
        <value model="ir.ui.menu" eval="{'name': obj().env.ref('rental.menu_product_product').with_context(lang='en_US').name}"/>
    </function>
    <function model="ir.ui.menu" name="write" context="{'lang': 'vi_VN'}">
        <value model="ir.ui.menu" eval="[ref('rental.menu_res_partner_renters')]"/>
        <value model="ir.ui.menu" eval="{'name': obj().env.ref('rental.menu_res_partner_renters').with_context(lang='en_US').name}"/>
    </function>
    <function model="ir.ui.menu" name="write" context="{'lang': 'vi_VN'}">
        <value model="ir.ui.menu" eval="[ref('rental.menu_transport_truck')]"/>
        <value model="ir.ui.menu" eval="{'name': obj().env.ref('rental.menu_transport_truck').with_context(lang='en_US').name}"/>
    </function>
</odoo>
