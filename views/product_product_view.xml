<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_product_product_tree_inherit_rental" model="ir.ui.view">
        <field name="name">product.product.tree.inherit.rental</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_product_tree_view"/>
        <field name="arch" type="xml">
            <xpath expr="//tree/field[@name='lst_price']" position="attributes">
                <attribute name="string">Giá thuê theo tháng</attribute>
            </xpath>
            <xpath expr="//tree/field[@name='lst_price']" position="after">
                <field name="rental_price_day" string="Giá thuê theo ngày" optional="show"/>
                <field name="compensation_price"/>
            </xpath>
        </field>
      </record>

    <record id="view_product_product_form_inherit_rental" model="ir.ui.view">
        <field name="name">product.product.form.inherit.rental</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_normal_form_view"/>
        <field name="arch" type="xml">
            <!-- Ẩn default_code/barcode chuẩn (tab Thông tin chung); default_code hiện lại ở Product variant detail -->
            <xpath expr="//field[@name='default_code']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='barcode']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//label[@for='standard_price']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//div[@name='standard_price_uom']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='product_tag_ids']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='additional_product_tag_ids']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='product_tag_ids']/following-sibling::button[@type='action'][1]" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

<!--            <xpath expr="//field[@name='lst_price']" position="after">-->
<!--                <field name="compensation_price" readonly="1"/>-->
<!--            </xpath>-->
            <xpath expr="//field[@name='product_template_variant_value_ids']" position="attributes">
                <attribute name="class">x_variant_tag_big</attribute>
            </xpath>

            <!--            Hide all notebook-->
            <xpath expr="//sheet/notebook" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//sheet" position="inside">
                <group string="Product variant detail">
                    <group>
                        <field name="categ_id"/>
                        <field name="staff_uom_category_id" invisible="1"/>
                        <field name="uom_id" domain="[('category_id.name','=','tbxd')]"/>
                        <field name="staff_display_uom_id"/>
                        <field name="default_code"/>
                    </group>
                    <group>
                        <field name="lst_price" string="Giá thuê theo tháng" widget="monetary" placeholder="1.000.000"/>
                        <field name="rental_price_day" string="Giá thuê theo ngày" widget="monetary" placeholder="1.000.000"/>
                        <field name="compensation_price" widget="monetary" placeholder="1.000.000"/>
                    </group>
                </group>
                <field name="description" placeholder="Description"/>
            </xpath>
        </field>
    </record>

    <record id="view_product_variant_easy_edit_view_inherit_rental" model="ir.ui.view">
        <field name="name">product.variant.easy.edit.view.inherit.rental</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_variant_easy_edit_view"/>
        <field name="arch" type="xml">
            <!-- Ẩn: Mã, Logistics, Thẻ, Đóng gói (giống form biến thể đầy đủ) -->
            <xpath expr="//group[@name='codes']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//group[@name='weight']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//group[@name='tags']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//group[@name='packaging']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

            <!-- Thay nhóm Pricing bằng layout 2 cột giống product_normal + rental -->
            <xpath expr="//group[@name='pricing']" position="replace">
                <group name="pricing" string="Product variant detail">
                    <group>
                        <field name="categ_id"/>
                        <field name="staff_uom_category_id" invisible="1"/>
                        <field name="uom_id" domain="[('category_id.name','=','tbxd')]"/>
                        <field name="staff_display_uom_id"/>
                        <field name="default_code"/>
                    </group>
                    <group>
                        <field name="product_variant_count" invisible="1"/>
                        <field name="currency_id" invisible="1"/>
                        <field name="cost_currency_id" invisible="1"/>
                        <field name="lst_price" string="Giá thuê theo tháng" widget="monetary" placeholder="1.000.000"
                               options="{'currency_field': 'currency_id', 'field_digits': True}"
                               readonly="product_variant_count &gt; 1"/>
                        <field name="rental_price_day" string="Giá thuê theo ngày" widget="monetary" placeholder="1.000.000"
                               options="{'currency_field': 'currency_id', 'field_digits': True}"/>
                        <field name="compensation_price" widget="monetary" placeholder="1.000.000"
                               options="{'currency_field': 'currency_id', 'field_digits': True}"/>
                    </group>
                </group>
            </xpath>

            <xpath expr="//group[@name='pricing']" position="after">
                <field name="description" placeholder="Description"/>
            </xpath>
        </field>
    </record>

    <record id="action_rental_product_variants" model="ir.actions.act_window">
        <field name="name">Product Variants</field>
        <field name="res_model">product.product</field>
        <field name="view_mode">tree,form</field>
        <!-- Optional: only saleable variants -->
        <!-- <field name="domain">[('sale_ok','=',True)]</field> -->
        <!-- Tip: if you want kanban here too, add it, but variants usually use list/form -->
    </record>
</odoo>
