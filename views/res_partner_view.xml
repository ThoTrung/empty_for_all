    <record id="action_ser_res_partner_my_company_profile" model="ir.actions.server">
        <field name="name">Hồ sơ công ty</field>
        <field name="model_id" ref="base.model_res_partner"/>
        <field name="state">code</field>
        <field name="code">
            action = {
                'type': 'ir.actions.act_window',
                'name': 'Hồ sơ công ty',
                'res_model': 'res.partner',
                'view_mode': 'form',
                'views': [(False, 'form')],
                'res_id': env.company.partner_id.id,   # ✅ open this record directly
                'context': {'create': False},
            }
        </field>
    </record>

