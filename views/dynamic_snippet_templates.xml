<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--    Blog post-->
    <!-- Five best records that we choose to display -->
    <template id="dynamic_filter_template_blog_post_5_best_recs" name="5 best recs">
        <div class="d-flex mt-3 s_blog_posts_post w-100 o_snippet_blog_5_best_recs" data-number-of-elements="1">
            <t t-set="first" t-value="records and records[0] or False"/>
            <t t-set="rest"  t-value="records and records[1:5] or []"/>
            <!--            <t t-esc="first"/>-->
            <!--            <t t-esc="slug(first['_record'])"/>-->
            <!-- LEFT: big card -->
            <div class="row w-100">
                <div class="col-12 col-xl-6">
                    <t t-if="first">
                        <t t-set="p" t-value="first['_record']"/>
                        <a t-att-href="'/' + slug(p)" class="o_blog_featured d-block overflow-hidden">
                            <div class="o_blog_featured__img"
                                 t-attf-style="background-image: url('/web/image/blog.post/#{p.id}/snippet_image_1920');">
                                <div class="o_blog_featured__body pb-3 px-2">
                                    <h2 class="o_blog_featured__title">
                                        <t t-esc="p.name"/>
                                    </h2>
<!--                                    <div class="o_blog_featured__meta">-->
<!--                                        <t t-esc="p.post_date"/>-->
<!--                                    </div>-->
                                    <t t-if="p.subtitle">
                                        <p class="o_blog_featured__subtitle mb-0">
                                            <t t-esc="p.subtitle"/>
                                        </p>
                                    </t>
                                </div>
                            </div>
                        </a>
                    </t>
                </div>

                <!-- RIGHT: 4 small cards (2x2) -->
                <div class="col-12 col-xl-6">
                    <div class="row g-1">
                        <t t-foreach="rest" t-as="r">
                            <t t-set="p" t-value="r['_record']"/>
                            <div class="col-6">
                                <a t-att-href="'/' + slug(p)" class="o_blog_card d-block overflow-hidden">
                                    <div class="o_blog_card__img"
                                         t-attf-style="background-image: url('/web/image/blog.post/#{p.id}/snippet_image_1920?width=320');">
                                        <div class="o_blog_card__body pb-2 px-1">
                                            <h3 class="o_blog_card__title">
                                                <t t-esc="p.name"/>
                                            </h3>
<!--                                            <div class="o_blog_card__meta">-->
<!--                                                <t t-esc="p.post_date"/>-->
<!--                                            </div>-->
                                        </div>
                                    </div>
                                </a>
                            </div>
                        </t>
                    </div>
                </div>
            </div>
        </div>
    </template>

    <!--    For product-->
    <template id="dynamic_filter_template_product_product_my_view_detail_2_cols" name="Two columns product preview">
        <t t-foreach="records" t-as="data" data-number-of-elements="2" data-thumb="/luxboat/static/src/img/snippets_options/product_preview_detail_in_2_cols.svg">
            <t t-set="record" t-value="data['_record']" data-arrow-position="bottom"/>
            <div class="o_carousel_product_card card h-100 w-100" t-att-data-add2cart-rerender="data.get('_add2cart_rerender')">
                <div t-if="is_sample" class="h5 o_ribbon_right bg-primary text-uppercase">Sample</div>
                <a class="o_carousel_product_img_link o_dynamic_product_hovered overflow-hidden" t-att-href="record.website_url">
                    <img class="card-img-top o_img_product_square o_img_product_cover h-auto" loading="lazy" t-att-src="data['image_512']" t-att-alt="record.display_name"/>
                </a>
                <div class="o_carousel_product_card_body card-body d-flex flex-column justify-content-between">
                    <div class="card-title h5" t-field="record.display_name"/>
                    <div class="card-text flex-grow-1 text-muted h6" t-field="record.description_sale"/>
                    <div class="mt-2">
                        <t t-if="is_view_active('website_sale.product_comment')" t-call="portal_rating.rating_widget_stars_static">
                            <t t-set="rating_avg" t-value="record.rating_avg"/>
                            <t t-set="rating_count" t-value="record.rating_count"/>
                        </t>
                    </div>
                    <div class="d-flex justify-content-between flex-wrap flex-md-column flex-lg-row align-items-center align-self-end w-100 mt-2 pt-3 border-top">
                        <div class="pb-2">
                            <!--                            <t t-call="website_sale.price_dynamic_filter_template_product_product"/>-->
                        </div>
                        <a class="btn btn-primary" t-att-href="record.website_url">
                            View detail
                        </a>
                    </div>
                </div>
            </div>
        </t>
    </template>

    <template id="dynamic_filter_template_blog_post_card_2_cols" name="Luxboat card layout">
        <div t-foreach="records" t-as="data" class="o_blog_post_card_2_cols s_blog_posts_post pb32 w-100" data-number-of-elements="2">
            <t t-set="record" t-value="data['_record']"/>
            <div class="card">
                <a class="s_blog_posts_post_cover o_blog_card d-block" t-att-href="'/' + slug(record)">
                    <div class="o_blog_card__img"
                                         t-attf-style="background-image: url('/web/image/blog.post/#{record.id}/snippet_image_1920?width=620');">
                    </div>
                </a>
                <div class="card-body">
                    <a t-att-href="'/' + slug(record)"><h4 class="mb-0" t-field="record.name"/></a>
                </div>
                <div class="card-footer d-flex justify-content-end">
                    <a class="btn btn-primary" t-att-href="'/' + slug(record)">
                        View detail
                    </a>
<!--                    <span class="text-muted mb-0" t-field="record.post_date" t-options='{"format": "MMM d, yyyy"}' />-->
<!--                    <span class="text-muted mb-0">In <a class="fw-bold" t-field="record.blog_id.name" t-att-href="'/blog/%s' % record.blog_id.id" />-->
<!--                        <a t-if="is_sample" class="fw-bold" href="#">Sample</a>-->
<!--                    </span>-->
                </div>
            </div>
        </div>
    </template>

    <template id="dynamic_filter_template_blog_post_card_3_cols" name="Luxboat card layout 3 cols">
        <div t-foreach="records" t-as="data" class="o_blog_post_card_2_cols s_blog_posts_post pb32 w-100" data-number-of-elements="3">
            <t t-set="record" t-value="data['_record']"/>
            <div class="card">
                <a class="s_blog_posts_post_cover o_blog_card d-block" t-att-href="'/' + slug(record)">
                    <div class="o_blog_card__img"
                                         t-attf-style="background-image: url('/web/image/blog.post/#{record.id}/snippet_image_1920?width=620');">
                    </div>
                </a>
                <div class="card-body">
                    <a t-att-href="'/' + slug(record)"><h4 class="mb-0" t-field="record.name"/></a>
                </div>
                <div class="card-footer d-flex justify-content-end">
                    <a class="btn btn-primary" t-att-href="'/' + slug(record)">
                        View detail
                    </a>
                </div>
            </div>
        </div>
    </template>
</odoo>