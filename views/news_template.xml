<!--We reuse blog structure - create new template call news-->

<odoo>
    <template id="news_list" name="News">
        <t t-call="website.layout">
            <div class="oe_structure"/>
            <div class="container my-5 o_blog_custom_list">
                <div class="oe_structure"/>
                <!-- TOP LAYOUT: big featured left, 2x2 grid right -->
                <t t-call="luxboat.snippet_blog_5_best_recs_tpl"/>
                <div class="oe_structure"/>
                <!-- Remaining posts below -->
            </div>
            <div class="oe_structure"/>
            <t t-call="luxboat.snippet_blog_remain_tpl"/>
            <div class="oe_structure"/>
            <t t-call="luxboat.snippet_blog_all_tpl"/>
            <div class="oe_structure"/>
        </t>
    </template>

    <template id="snippet_blog_5_best_recs_tpl">
        <div class="mt-3 s_blog_posts_post w-100 o_snippet_blog_5_best_recs">
            <t t-set="first" t-value="records and records[0] or False"/>
            <t t-set="rest"  t-value="records and records[1:5] or []"/>
            <div class="row">
                <div class="col-12 text-center mb-4">
                    <h2 class="h3 mb-2">Tiêu đề</h2>
                    <p class="text-muted mb-0">Mô tả.</p>
                </div>
            </div>
            <div class="row g-1">
                <!-- Left -->
                <div class="col-12 col-lg-6">
                    <t t-if="first">
                        <t t-set="p" t-value="first"/>
                        <a t-att-href="'/' + slug(p)" class="o_blog_featured d-block overflow-hidden">
                            <div class="o_blog_featured__img"
                                 t-attf-style="background-image: url('/web/image/blog.post/#{p.id}/snippet_image_1920');">
                                <div class="o_blog_featured__body pb-3 px-2">
                                    <h2 class="o_blog_featured__title">
                                        <t t-esc="p.name"/>
                                    </h2>
                                    <!--                                    <div class="o_blog_featured__meta">-->
                                    <!--                                        <t t-esc="p.post_date"/>-->
                                    <!--                                    </div>-->
                                    <t t-if="p.subtitle">
                                        <p class="o_blog_featured__subtitle mb-0">
                                            <t t-esc="p.subtitle"/>
                                        </p>
                                    </t>
                                </div>
                            </div>
                        </a>
                    </t>
                </div>

                <!-- 2x2 grid (right) -->
                <div class="col-12 col-xl-6">
                    <div class="row g-1">
                        <!--                    <div class="row">-->
                        <t t-foreach="rest" t-as="r">
                            <t t-set="p" t-value="r"/>
                            <div class="col-6">
                                <a t-att-href="'/' + slug(p)" class="o_blog_card d-block overflow-hidden">
                                    <div class="o_blog_card__img"
                                         t-attf-style="background-image: url('/web/image/blog.post/#{p.id}/snippet_image_1920?width=320');">
                                        <div class="o_blog_card__body pb-2 px-1">
                                            <h3 class="o_blog_card__title">
                                                <t t-esc="p.name"/>
                                            </h3>
                                            <!--                                            <div class="o_blog_card__meta">-->
                                            <!--                                                <t t-esc="p.post_date"/>-->
                                            <!--                                            </div>-->
                                        </div>
                                    </div>
                                </a>
                            </div>
                        </t>
                    </div>
                </div>
            </div>
        </div>
    </template>

    <template id="snippet_blog_remain_tpl">
        <t t-if="remaining">
            <div class="container g-4 pt-5">
                <div class="row o_snippet_blog_5_best_recs g-1">
                    <t t-foreach="remaining" t-as="p">
                        <div class="col-12 col-md-6 col-lg-3">
                            <t t-call="luxboat._post_card"/>
                        </div>
                    </t>
                </div>
            </div>
            <div class="pt-3 text-center">
                <a class="btn btn-primary" href="/tat-ca-tin-tuc">
                    View all
                </a>
            </div>
        </t>
    </template>
    <template id="snippet_blog_all_tpl">
        <div>
            <!-- Pager -->
            <t t-if="pager">
                <div class="mt-5">
                    <t t-call="website.pager"/>
                </div>
            </t>
        </div>
    </template>

    <!-- Reusable small card -->
    <template id="_post_card" name="Post Card (Custom)">
        <a t-att-href="'/' + slug(p)" class="o_blog_card d-block overflow-hidden">
            <div class="o_blog_card__img"
                 t-attf-style="background-image: url('/web/image/blog.post/#{p.id}/snippet_image_1920?width=320');">
                <div class="o_blog_card__body pb-2 px-1">
                    <h3 class="o_blog_card__title">
                        <t t-esc="p.name"/>
                    </h3>
                </div>
            </div>
        </a>
    </template>

    <!--  Inherit the detail blog template-->
    <template id="luxboat_post_breadcrumbs_tin_tuc" inherit_id="website_blog.post_breadcrumbs">
        <!-- Optional: replace breadcrumb text -->
        <xpath expr="//nav//li[2]//a" position="replace">
            <a t-att-href="'/tin-tuc'">Tin tức</a>
        </xpath>
    </template>


    <template id="all_news_list" name="News">
        <t t-call="website.layout">
            <div class="oe_structure"/>
            <div class="container pt-5">
                <div class="row o_snippet_blog_5_best_recs">
                    <t t-foreach="records" t-as="p">
                        <div class="col-12 col-md-6 col-lg-3 p-2">
                            <t t-call="luxboat._post_card"/>
                        </div>
                    </t>
                </div>
            </div>
            <div>
                <t t-if="pager">
                    <div class="mt-4 d-flex justify-content-center">
                        <t t-call="website.pager"/>
                    </div>
                </t>
            </div>
            <div class="oe_structure"/>
        </t>
    </template>

</odoo>
