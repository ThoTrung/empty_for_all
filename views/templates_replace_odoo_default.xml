<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <template id="remove_brand_promotion" inherit_id="website.brand_promotion" name="Remove Powered by Odoo">
            <xpath expr="//div[contains(@class, 'o_brand_promotion')]" position="replace"/>
        </template>
    </data>
</odoo>
