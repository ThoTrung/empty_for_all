<!--                                <field name="acc_number"/>-->
<!--                                <field name="bank_id"/>-->
<!--                                <field name="currency_id"/>-->
<!--                            </tree>-->
<!--                            <form>-->
<!--                                <sheet>-->
<!--                                    <group>-->
<!--                                        <field name="partner_id" readonly="1"/>-->
<!--                                        <field name="acc_number"/>-->
<!--                                        <field name="bank_id"/>-->
<!--                                        <field name="currency_id"/>-->
<!--                                    </group>-->
<!--                                </sheet>-->
<!--                            </form>-->
<!--                        </field>-->

<!--                        <field name="main_bank_account_id"/>-->
                    </group>
                </page>
            </xpath>

        </field>
    </record>
</odoo>
