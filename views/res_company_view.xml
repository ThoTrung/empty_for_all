<!-- company_extra_info/views/res_company_views.xml -->
<odoo>
    <record id="view_company_form_extra_info" model="ir.ui.view">
        <field name="name">res.company.form.extra.info</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">

            <!-- Add Representative block near core identity fields -->
            <xpath expr="//group[.//field[@name='partner_id']]" position="after">
                <group string="Representative">
                    <field name="representative_id"/>
                    <field name="representative_position"/>
                </group>
            </xpath>

            <!-- Add a Bank Accounts tab using standard res.partner.bank -->
            <xpath expr="//notebook" position="inside">
                <page string="Bank Accounts">
                    <group>
<!--                        <field name="company_partner_for_domain_id" invisible="1"/>-->

                        <field name="bank_ids"/>
