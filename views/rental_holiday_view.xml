<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_rental_holiday_tree" model="ir.ui.view">
        <field name="name">rental.holiday.tree</field>
        <field name="model">rental.holiday</field>
        <field name="arch" type="xml">
            <tree string="Ngày nghỉ" default_order="date_from desc">
                <field name="name"/>
                <field name="date_from"/>
                <field name="date_to"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="active"/>
            </tree>
        </field>
    </record>

    <record id="view_rental_holiday_form" model="ir.ui.view">
        <field name="name">rental.holiday.form</field>
        <field name="model">rental.holiday</field>
        <field name="arch" type="xml">
            <form string="Khoảng ngày nghỉ">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="date_from"/>
                            <field name="date_to"/>
                        </group>
                        <group>
                            <field name="company_id" groups="base.group_multi_company" invisible="1"/>
                            <field name="active" invisible="1"/>
                        </group>
                    </group>
                    <group>
                        <field name="note" string="Ghi chú" placeholder="Ví dụ: Nghỉ Tết âm lịch..."/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_rental_holiday" model="ir.actions.act_window">
        <field name="name">Ngày nghỉ</field>
        <field name="res_model">rental.holiday</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{'search_default_active': 1}</field>
    </record>
</odoo>
