<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_picking_form_rental_qty_readonly_demand" model="ir.ui.view">
        <field name="name">stock.picking.form.rental.demand.readonly</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='origin']" position="after">
                <field name="rental_transport_id" invisible="1"/>
            </xpath>
            <!-- Phiếu gắn rr.transport: chỉ sửa Số lượng, không sửa Nhu cầu. -->
            <xpath expr="//page[@name='operations']//field[@name='move_ids_without_package']/tree/field[@name='product_uom_qty']"
                   position="attributes">
                <attribute name="readonly">parent.rental_transport_id or not is_initial_demand_editable</attribute>
            </xpath>
        </field>
    </record>
</odoo>
