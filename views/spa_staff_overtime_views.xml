<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_spa_staff_overtime_tree" model="ir.ui.view">
        <field name="name">spa.staff.overtime.request.tree</field>
        <field name="model">spa.staff.overtime.request</field>
        <field name="arch" type="xml">
            <tree string="Làm thêm giờ" decoration-info="state=='draft'" decoration-warning="state=='submitted'" decoration-success="state=='approved'">
                <field name="name"/>
                <field name="employee_id"/>
                <field name="overtime_date"/>
                <field name="hours"/>
                <field name="state"/>
            </tree>
        </field>
    </record>
    <record id="view_spa_staff_overtime_form" model="ir.ui.view">
        <field name="name">spa.staff.overtime.request.form</field>
        <field name="model">spa.staff.overtime.request</field>
        <field name="arch" type="xml">
            <form string="Làm thêm giờ">
                <header>
                    <button name="action_submit" string="Gửi duyệt" type="object" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_approve" string="Duyệt" type="object" class="btn-primary" invisible="state != 'submitted'" groups="spa_staff_payroll.group_spa_payroll_manager,hr.group_hr_user"/>
                    <button name="action_reject" string="Từ chối" type="object" invisible="state != 'submitted'" groups="spa_staff_payroll.group_spa_payroll_manager,hr.group_hr_user"/>
                    <button name="action_reset_draft" string="Đặt lại nháp" type="object" invisible="state != 'rejected'" groups="spa_staff_payroll.group_spa_payroll_manager"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,submitted,approved"/>
                </header>
                <sheet>
                    <group>
                        <field name="name" readonly="1"/>
                        <field name="employee_id"/>
                        <field name="overtime_date"/>
                        <field name="hours" default_focus="1"/>
                        <field name="note"/>
                        <field name="approved_by" readonly="1"/>
                        <field name="approved_date" readonly="1"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="action_spa_staff_overtime" model="ir.actions.act_window">
        <field name="name">Đăng ký làm thêm giờ</field>
        <field name="res_model">spa.staff.overtime.request</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
