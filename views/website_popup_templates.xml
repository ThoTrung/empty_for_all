<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <data>

    <template id="luxboat_popup_in_layout" inherit_id="website.layout" name="Luxboat Popup Inject">
      <xpath expr="//body" position="inside">

        <!-- One modal shell, content filled by JS -->
        <div class="modal fade" id="luxboat_website_popup_modal" tabindex="-1" aria-hidden="true">
          <div class="modal-dialog modal-dialog-centered modal-md">
            <div class="modal-content">
              <div class="modal-body p-0 position-relative">
                <button style="position:absolute; right: 0.5rem; top: 0.5rem; z-index: 10;" type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"/>
                <div class="d-flex flex-column flex-lg-row">
                  <div class="lux_popup_cover flex-shrink-0" style="width:100%;">
                    <img class="lux_popup_cover_img w-100" alt="" style="display:none;"/>
                    <div class="p-3 p-lg-4">
                      <h4 class="lux_popup_title mb-2" style="display:none;"></h4>
                      <div class="lux_popup_body mb-3"></div>
                      <a class="btn btn-primary lux_popup_primary_btn" href="javascript:void(0)">OK</a>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>

      </xpath>
    </template>

  </data>
</odoo>
