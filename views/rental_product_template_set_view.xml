<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_rental_product_template_set_tree" model="ir.ui.view">
        <field name="name">rental.product.template.set.tree</field>
        <field name="model">rental.product.template.set</field>
        <field name="arch" type="xml">
            <tree string="Mẫu sản phẩm hợp đồng">
                <field name="name"/>
                <field name="company_id"/>
                <field name="product_count"/>
                <field name="active"/>
            </tree>
        </field>
    </record>

    <record id="view_rental_product_template_set_form" model="ir.ui.view">
        <field name="name">rental.product.template.set.form</field>
        <field name="model">rental.product.template.set</field>
        <field name="arch" type="xml">
            <form string="Mẫu sản phẩm hợp đồng">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="company_id"/>
                        <field name="active"/>
                    </group>
                    <field name="line_ids" context="{'default_company_id': company_id}">
                        <tree editable="bottom">
                            <field name="sequence" widget="handle"/>
                            <field name="product_tmpl_id" options="{'no_create_edit': True}"/>
                            <field name="name" optional="hide"/>
                            <field name="uom_id" optional="show"/>
                            <field name="product_uom_qty" optional="show"/>
                            <field name="company_id" optional="hide"/>
                            <field name="price_unit" widget="monetary" optional="show"/>
                            <field name="compensation_price" widget="monetary" optional="show"/>
                            <field name="currency_id" column_invisible="True"/>
                        </tree>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_rental_product_template_set" model="ir.actions.act_window">
        <field name="name">Mẫu sản phẩm hợp đồng</field>
        <field name="res_model">rental.product.template.set</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{}</field>
    </record>
</odoo>
