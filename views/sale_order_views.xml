<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_order_form_inherit_rental_staff_uom" model="ir.ui.view">
        <field name="name">sale.order.form.inherit.rental.staff.uom</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='order_line']//tree/field[@name='product_uom'][@optional='show']" position="after">
                <field name="staff_display_uom_id" string="ĐVT hiển thị" optional="show" readonly="1" groups="uom.group_uom"/>
            </xpath>
        </field>
    </record>
</odoo>
