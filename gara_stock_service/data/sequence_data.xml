<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="seq_gara_service_stock_request" model="ir.sequence">
            <field name="name">Gara service stock request</field>
            <field name="code">gara.service.stock.request</field>
            <field name="prefix">GSR/%(y)s/</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>
        <record id="seq_gara_stock_inventory_batch" model="ir.sequence">
            <field name="name">Gara stock inventory batch</field>
            <field name="code">gara.stock.inventory.batch</field>
            <field name="prefix">GINV/%(y)s/</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>
    </data>
</odoo>
