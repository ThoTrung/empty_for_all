<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_gara_stock_inventory_batch_tree" model="ir.ui.view">
        <field name="name">gara.stock.inventory.batch.tree</field>
        <field name="model">gara.stock.inventory.batch</field>
        <field name="arch" type="xml">
            <tree decoration-muted="state == 'cancel'" decoration-success="state == 'done'">
                <field name="name"/>
                <field name="inventory_date"/>
                <field name="warehouse_id"/>
                <field name="location_id"/>
                <field name="responsible_id"/>
                <field name="line_count"/>
                <field name="difference_line_count"/>
                <field name="state"/>
                <field name="company_id"/>
            </tree>
        </field>
    </record>

    <record id="view_gara_stock_inventory_batch_form" model="ir.ui.view">
        <field name="name">gara.stock.inventory.batch.form</field>
        <field name="model">gara.stock.inventory.batch</field>
        <field name="arch" type="xml">
            <form string="Inventory Batch">
                <header>
                    <button name="action_load_products" type="object" string="Load Products" invisible="state != 'draft'"/>
                    <button name="action_confirm" type="object" string="Confirm" invisible="state != 'draft'"/>
                    <button name="action_done" type="object" string="Done" invisible="state != 'confirmed'"/>
                    <button name="action_cancel" type="object" string="Cancel" invisible="state in ('done','cancel')"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,confirmed,done"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="inventory_date" readonly="state != 'draft'"/>
                            <field name="responsible_id" readonly="state != 'draft'"/>
                            <field name="company_id" readonly="state != 'draft'"/>
                        </group>
                        <group>
                            <field name="warehouse_id" readonly="state != 'draft'"/>
                            <field name="location_id" readonly="state != 'draft'"/>
                            <field name="line_count"/>
                            <field name="difference_line_count"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Inventory Lines">
                            <field name="line_ids" readonly="state not in ('draft','confirmed')">
                                <tree editable="bottom" decoration-danger="difference_qty &lt; 0" decoration-warning="difference_qty &gt; 0">
                                    <field name="sequence" widget="handle"/>
                                    <field name="product_id"/>
                                    <field name="product_uom_id"/>
                                    <field name="theoretical_qty"/>
                                    <field name="counted_qty"/>
                                    <field name="difference_qty"/>
                                    <field name="note"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Notes">
                            <field name="note" nolabel="1"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_gara_stock_inventory_batch_search" model="ir.ui.view">
        <field name="name">gara.stock.inventory.batch.search</field>
        <field name="model">gara.stock.inventory.batch</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="warehouse_id"/>
                <field name="location_id"/>
                <field name="responsible_id"/>
                <filter name="draft" string="Draft" domain="[('state', '=', 'draft')]"/>
                <filter name="confirmed" string="Confirmed" domain="[('state', '=', 'confirmed')]"/>
                <filter name="done" string="Done" domain="[('state', '=', 'done')]"/>
                <group expand="0" string="Group By">
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                    <filter name="group_warehouse" string="Warehouse" context="{'group_by': 'warehouse_id'}"/>
                    <filter name="group_responsible" string="Responsible" context="{'group_by': 'responsible_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_gara_stock_inventory_batch_line_tree" model="ir.ui.view">
        <field name="name">gara.stock.inventory.batch.line.tree</field>
        <field name="model">gara.stock.inventory.batch.line</field>
        <field name="arch" type="xml">
            <tree decoration-danger="difference_qty &lt; 0" decoration-warning="difference_qty &gt; 0">
                <field name="inventory_date"/>
                <field name="batch_id"/>
                <field name="warehouse_id"/>
                <field name="location_id"/>
                <field name="product_id"/>
                <field name="product_uom_id"/>
                <field name="theoretical_qty"/>
                <field name="counted_qty"/>
                <field name="difference_qty"/>
                <field name="company_id"/>
            </tree>
        </field>
    </record>

    <record id="view_gara_stock_inventory_batch_line_search" model="ir.ui.view">
        <field name="name">gara.stock.inventory.batch.line.search</field>
        <field name="model">gara.stock.inventory.batch.line</field>
        <field name="arch" type="xml">
            <search>
                <field name="batch_id"/>
                <field name="product_id"/>
                <field name="warehouse_id"/>
                <field name="location_id"/>
                <filter name="has_difference" string="Có chênh lệch" domain="[('difference_qty', '!=', 0)]"/>
                <filter name="shortage" string="Thiếu" domain="[('difference_qty', '&lt;', 0)]"/>
                <filter name="surplus" string="Thừa" domain="[('difference_qty', '&gt;', 0)]"/>
                <group expand="0" string="Group By">
                    <filter name="group_batch" string="Batch" context="{'group_by': 'batch_id'}"/>
                    <filter name="group_product" string="Product" context="{'group_by': 'product_id'}"/>
                    <filter name="group_warehouse" string="Warehouse" context="{'group_by': 'warehouse_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_gara_stock_inventory_batch" model="ir.actions.act_window">
        <field name="name">Đợt kiểm kê</field>
        <field name="res_model">gara.stock.inventory.batch</field>
        <field name="view_mode">tree,form</field>
    </record>

    <record id="action_gara_stock_inventory_summary" model="ir.actions.act_window">
        <field name="name">Tổng hợp kiểm kê</field>
        <field name="res_model">gara.stock.inventory.batch.line</field>
        <field name="view_mode">tree,pivot,graph</field>
        <field name="domain">[('difference_qty', '!=', 0)]</field>
        <field name="search_view_id" ref="view_gara_stock_inventory_batch_line_search"/>
        <field name="context">{'search_default_has_difference': 1}</field>
    </record>
</odoo>
